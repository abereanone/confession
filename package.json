{
  "name": "confessions-hub",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "build": "npm run build:web",
    "sync:confessions": "node ./scripts/sync-shared-data.mjs",
    "data:prepare-bsb": "node ./shared/data/scripts/prepare-bsb.mjs",
    "data:fix-bsb-text": "node ./shared/data/scripts/fixBSBdotTEXT.mjs",
    "data:find-gaps": "cd shared/data && node ./scripts/findGaps.mjs",
    "seed:bsb": "npm run data:prepare-bsb",
    "predev:web": "npm run sync:confessions",
    "dev:web": "npm --workspace @confessions-hub/web run dev",
    "prebuild:web": "npm run sync:confessions",
    "build:web": "npm --workspace @confessions-hub/web run build",
    "predev:mobile": "npm run sync:confessions",
    "dev:mobile": "npm --workspace @confessions-hub/mobile run start",
    "preandroid": "npm run sync:confessions",
    "android": "npm --workspace @confessions-hub/mobile run android",
    "preios": "npm run sync:confessions",
    "ios": "npm --workspace @confessions-hub/mobile run ios"
  }
}
