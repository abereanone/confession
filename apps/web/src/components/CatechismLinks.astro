---
// The catechism questions that expound one confession paragraph.
//
// Deliberately quiet: a paragraph of the confession is the thing being read,
// and these are a side door out to catechize.ing. Only high and medium
// confidence links appear here — a low-confidence guess is worth recording in
// the data and showing on the mapping page, but not worth putting under the
// text as though the confession claimed it.

import { questionsForParagraph, type ParagraphQuestion } from "../lib/catechism";

interface Props {
  confessionSlug: string;
  unitNumber: number;
  paragraphNumber: number;
}

const { confessionSlug, unitNumber, paragraphNumber } = Astro.props;

// High and medium links both show. They arrive already ordered strongest first
// (see questionsForParagraph), and everything past VISIBLE is collapsed behind
// a toggle — which is what keeps a long list from becoming noise, rather than
// throwing links away. Westminster 11.1 draws eleven.
const VISIBLE = 4;

const questions: ParagraphQuestion[] = questionsForParagraph(
  confessionSlug,
  unitNumber,
  paragraphNumber
).filter((question) => question.confidence === "high" || question.confidence === "medium");

// One over the limit is not worth a toggle — showing "+1 more" costs the same
// room as the chip it hides.
const collapsed = questions.length > VISIBLE + 1;
const hiddenCount = questions.length - VISIBLE;
---

{
  questions.length > 0 && (
    <aside
      class="catechism-links"
      aria-label="Catechism questions on this paragraph"
      data-catechism-links
      data-collapsed={collapsed ? "true" : undefined}
    >
      <span class="catechism-label">Catechism</span>
      <ul class="catechism-chips">
        {questions.map((question) => (
          <li>
            <a
              class="catechism-chip"
              href={question.href}
              data-confidence={question.confidence}
              data-secondary={question.secondary ? "true" : undefined}
              target="_blank"
              rel="noopener noreferrer"
              title={`${question.catechism.label} ${question.n}. ${question.title}`}
            >
              <span class="chip-doc">{question.catechism.short}</span>
              <span class="chip-n">{question.n}</span>
              <span class="chip-title">{question.title}</span>
            </a>
          </li>
        ))}
      </ul>
      {collapsed && (
        <button type="button" class="catechism-more" data-catechism-more aria-expanded="false">
          +{hiddenCount} more
        </button>
      )}
    </aside>
  )
}

<script>
  // The button and the collapsed state are rendered on the server, so the
  // styling is Astro-scoped and the markup is correct before any JS runs. This
  // only flips the attribute the CSS keys off.
  //
  // An earlier version built the button in JS, which silently lost the scoped
  // style attribute and rendered it as a bare browser button.
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-catechism-more]")) {
    const group = button.closest<HTMLElement>("[data-catechism-links]");
    if (!group) continue;

    const label = button.textContent?.trim() ?? "";

    button.addEventListener("click", () => {
      const collapsed = group.dataset.collapsed === "true";
      if (collapsed) {
        delete group.dataset.collapsed;
      } else {
        group.dataset.collapsed = "true";
      }
      button.setAttribute("aria-expanded", String(collapsed));
      button.textContent = collapsed ? "Show fewer" : label;
    });
  }
</script>

<style>
  .catechism-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.65rem;
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--surface-border);
  }

  .catechism-label {
    flex: none;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .catechism-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .catechism-chip {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    max-width: min(30rem, 100%);
    padding: 0.22rem 0.6rem;
    border: 1px solid var(--surface-border);
    border-radius: 999px;
    background: var(--surface-bg-muted);
    color: var(--color-text);
    font-size: 0.85rem;
    line-height: 1.45;
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }

  .catechism-chip:hover,
  .catechism-chip:focus-visible {
    border-color: var(--surface-border-strong);
    background: var(--surface-bg-hover);
  }

  /* A medium-confidence link is a suggestion, not a statement, and reads as
     one: the same chip with its outline dashed rather than a different colour,
     which would compete with the confession accents. */
  .catechism-chip[data-confidence="medium"] {
    border-style: dashed;
    background: transparent;
  }

  /* Collapse in CSS rather than with the `hidden` attribute, which any author
     rule setting `display` would silently defeat. The 5 is VISIBLE + 1 — keep
     the two in step. Hidden chips stay in the DOM, so they are still in the
     markup for anything reading the page rather than looking at it. */
  .catechism-links[data-collapsed="true"] .catechism-chips > li:nth-child(n + 5) {
    display: none;
  }

  .catechism-more {
    flex: none;
    padding: 0.22rem 0.55rem;
    border: 1px dashed var(--surface-border);
    border-radius: 999px;
    background: transparent;
    color: var(--color-muted);
    font: inherit;
    font-size: 0.78rem;
    cursor: pointer;
  }

  .catechism-more:hover,
  .catechism-more:focus-visible {
    border-color: var(--surface-border-strong);
    color: var(--color-text);
  }

  .chip-doc {
    flex: none;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .chip-n {
    flex: none;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    color: var(--color-link);
  }

  .chip-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .catechism-chip[data-secondary] .chip-title {
    color: var(--color-muted);
  }

  @media (max-width: 640px) {
    .chip-title {
      max-width: 14rem;
    }
  }
</style>
