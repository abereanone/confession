---
import { siteSettings } from "../lib/siteSettings";

const issueReportURL = siteSettings.issueReportUrl;
const logoUrl = "/lockup.svg";
---

<footer class="site-footer">
  <div class="footer-search" aria-label="Footer quick links">
    <a href="/confessions" class="footer-search-link">Confessions</a>
    <a href="https://catechize.ing" class="footer-search-link">Catechisms</a>
    <a href="/scriptures" class="footer-search-link">Scripture Index</a>
    <a href="/bible" class="footer-search-link">Bible Reader</a>
    <a href="/bible/bookmarks" class="footer-search-link">Bookmarks</a>
    <a href="/bible/changes" class="footer-search-link">What's New?</a>
  </div>
  <p class="footer-links">
    <a href="/about">About</a> |
    <a href="/copyright">Copyright Info</a> |
    <a href="https://catechize.ing">Catechisms</a> |
    <a href={issueReportURL} target="_blank" rel="noopener noreferrer">Report an Issue</a>
  </p>
  <p class="footer-meta">Freely Given</p>
  <a href="/" class="footer-brand" aria-label={`${siteSettings.siteName} home`}>
    <img src={logoUrl} alt={siteSettings.siteName} class="footer-logo" width="1080" height="380" />
  </a>
</footer>

<style>
  .site-footer {
    text-align: center;
    margin-top: 1.4rem;
    padding: 1.5rem 1rem 3rem;
    border-top: 1px solid var(--surface-border);
    background: var(--surface-bg-muted);
  }

  .footer-brand {
    display: inline-flex;
    justify-content: center;
    margin-top: 1.25rem;
  }

  .footer-logo {
    width: min(92vw, 34rem);
    height: auto;
    object-fit: contain;
  }

  .footer-search {
    display: inline-flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 0.7rem;
  }

  .footer-search-link {
    display: inline-block;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--surface-border);
    background: var(--surface-bg-strong);
    color: var(--color-text);
    font-weight: 600;
    text-decoration: none;
  }

  .footer-search-link:hover,
  .footer-search-link:focus-visible {
    background: var(--surface-bg-hover);
    border-color: var(--surface-border-strong);
    text-decoration: none;
  }

  .footer-links {
    margin: 0;
  }

  .footer-meta {
    margin: 0.35rem 0 0;
    color: var(--color-muted);
    font-size: 0.95rem;
  }
</style>
