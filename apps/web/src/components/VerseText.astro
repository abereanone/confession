---
// Verse text with the BSB's plural-you mark (you+, your+, yours+) shown as a small raised +.
const { text = "" } = Astro.props;
const parts = String(text).split(/([A-Za-z])\+/);
---

{parts.map((part, index) => (index % 2 === 1 ? <>{part}<sup class="plural-you">+</sup></> : part))}

<style>
  .plural-you {
    font-size: 0.7em;
    line-height: 0;
  }
</style>
