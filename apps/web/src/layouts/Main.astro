---
import { createHash } from "node:crypto";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import { siteSettings } from "../lib/siteSettings";
import Footer from "../components/Footer.astro";
import AppInstall from "../components/AppInstall.astro";

const { title = siteSettings.siteName } = Astro.props;
const gaMeasurementId = siteSettings.analytics.googleAnalyticsMeasurementId;
const siteDescription = "Search and read historic Christian confessions with their Scripture references.";
const logoUrl = "/logo.svg";
const siteUrl = "https://confess.catechize.ing";
const ogImageUrl = `${siteUrl}/ogLogo.png`;
// Built from the production origin rather than Astro.url so that preview deploys and
// any proxied domain still declare the canonical host, and so query strings and hashes
// are dropped -- /bible/gen/1/?x=1 and /bible/gen/1/ are one page, not two.
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
// Register the service worker only in built output, so dev HMR isn't intercepted.
const enablePwa = import.meta.env.PROD;
// Which bottom tab (phones only) is lit for this page.
const path = Astro.url.pathname;
const activeTab = path.startsWith("/bible/bookmarks")
  ? "bookmarks"
  : path.startsWith("/bible")
    ? "bible"
    : path.startsWith("/scriptures")
      ? "scriptures"
      : path === "/" || path.startsWith("/confessions") || path.startsWith("/compare")
        ? "confessions"
        : "";

// theme.css lives in public/, so it is served as-is with no hash in its name, and
// the service worker answers asset requests from cache first. Without a version
// in the URL, a changed theme is not seen until a second reload (or never, for a
// browser holding a long-lived copy). A content hash makes each edit a new URL.
let themeVersion = "0";
try {
  const themeCss = readFileSync(resolve(process.cwd(), "public/styles/theme.css"));
  themeVersion = createHash("sha1").update(themeCss).digest("hex").slice(0, 10);
} catch {
  // Falls back to an unversioned URL's behaviour rather than failing the build.
}
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={siteDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={`${siteSettings.siteName} social preview`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <link rel="icon" href="/favicon.ico" />
    <meta name="theme-color" content="#e6eee6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1712" media="(prefers-color-scheme: dark)" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Confessions Hub" />
    <title>{title}</title>
    {enablePwa ? (
      <script is:inline>
        if ("serviceWorker" in navigator) {
          window.addEventListener("load", () => {
            navigator.serviceWorker.register("/sw.js").catch(() => {});
          });
        }
      </script>
    ) : null}
    {siteSettings.analytics.enabled ? (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script is:inline define:vars={{ gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag("js", new Date());
          gtag("config", gaMeasurementId, {
            anonymize_ip: true,
          });
        </script>
      </>
    ) : null}
    <script is:inline>
      (() => {
        const storageKey = "site-theme";
        const readerStorageKey = "site-reader-mode";
        const root = document.documentElement;

        const readStoredTheme = () => {
          try {
            const value = window.localStorage.getItem(storageKey);
            return value === "light" || value === "dark" ? value : null;
          } catch {
            return null;
          }
        };

        const readStoredReaderMode = () => {
          try {
            const value = window.localStorage.getItem(readerStorageKey);
            return value === "read" || value === "study" ? value : null;
          } catch {
            return null;
          }
        };

        const prefersDark = () => {
          if (typeof window.matchMedia !== "function") {
            return null;
          }
          try {
            return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          } catch {
            return null;
          }
        };

        root.dataset.theme = readStoredTheme() || prefersDark() || "light";
        // Phones open in Reading Mode until the reader picks a mode themselves.
        const isPhone = () => {
          try {
            return window.matchMedia("(max-width: 720px)").matches;
          } catch {
            return false;
          }
        };
        root.dataset.readerMode = readStoredReaderMode() || (isPhone() ? "read" : "study");
      })();
    </script>
    <link rel="stylesheet" href={`/styles/theme.css?v=${themeVersion}`} />
  </head>
  <body>
    <header class="top">
      <a href="/" class="brand" aria-label={`${siteSettings.siteName} home`}>
        <img src={logoUrl} alt="" class="brand-logo" width="96" height="96" />
      </a>
      <nav class="top-nav">
        <a href="/">Confessions</a>
        <a href="/scriptures">Scriptures</a>
        <a href="/bible">Bible</a>
        <a href="/bible/bookmarks">Bookmarks</a>
      </nav>
      <a href="/bible" class="header-bible" aria-current={activeTab === "bible" ? "page" : undefined}>Bible</a>
      <button
        type="button"
        class="menu-toggle"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label="Menu"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
      <div class="header-controls" id="site-menu" data-site-menu>
        <AppInstall />
        <button type="button" class="reader-toggle" data-reader-toggle aria-label="Toggle reading mode">
          <span data-reader-toggle-label>Reading Mode</span>
        </button>
        <button type="button" class="theme-toggle" data-theme-toggle aria-label="Toggle color theme">
          <span data-theme-toggle-label>Dark</span>
        </button>
        <div class="menu-links">
          <a href="/compare">Compare confessions</a>
          <a href="/bible/changes">What's New?</a>
          <a href="/resources">Resources</a>
          <a href="/about">About</a>
        </div>
      </div>
    </header>
    <nav class="tabbar" aria-label="Main">
      <a href="/" aria-current={activeTab === "confessions" ? "page" : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 3h9l3 3v15H6z" /><path d="M9 10h6M9 14h6" /></svg>
        Confessions
      </a>
      <a href="/scriptures" aria-current={activeTab === "scriptures" ? "page" : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 6h16M4 12h10M4 18h13" /></svg>
        Scriptures
      </a>
      <a href="/bible" aria-current={activeTab === "bible" ? "page" : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3z" /><path d="M12 8v6M9 11h6" /></svg>
        Bible
      </a>
      <a href="/bible/bookmarks" aria-current={activeTab === "bookmarks" ? "page" : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 4h12v17l-6-4-6 4z" /></svg>
        Bookmarks
      </a>
    </nav>
    <main>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (() => {
        const storageKey = "site-theme";
        const readerStorageKey = "site-reader-mode";
        const root = document.documentElement;

        const readStoredTheme = () => {
          try {
            const value = window.localStorage.getItem(storageKey);
            return value === "light" || value === "dark" ? value : null;
          } catch {
            return null;
          }
        };

        const writeStoredTheme = (theme) => {
          try {
            window.localStorage.setItem(storageKey, theme);
          } catch {
            // ignore
          }
        };

        const readStoredReaderMode = () => {
          try {
            const value = window.localStorage.getItem(readerStorageKey);
            return value === "read" || value === "study" ? value : defaultReaderMode();
          } catch {
            return defaultReaderMode();
          }
        };

        // Matches the head script: phones default to Reading Mode.
        const defaultReaderMode = () => {
          try {
            return window.matchMedia("(max-width: 720px)").matches ? "read" : "study";
          } catch {
            return "study";
          }
        };

        const writeStoredReaderMode = (mode) => {
          try {
            window.localStorage.setItem(readerStorageKey, mode);
          } catch {
            // ignore
          }
        };

        const updateButtons = (theme) => {
          document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
            button.setAttribute("aria-pressed", theme === "dark" ? "true" : "false");
            const label = button.querySelector("[data-theme-toggle-label]");
            if (label) {
              label.textContent = theme === "dark" ? "Light" : "Dark";
            }
          });
        };

        const updateReaderButtons = (mode) => {
          document.querySelectorAll("[data-reader-toggle]").forEach((button) => {
            button.setAttribute("aria-pressed", mode === "read" ? "true" : "false");
            const label = button.querySelector("[data-reader-toggle-label]");
            if (label) {
              // Action-style label: show the mode the click will activate.
              label.textContent = mode === "read" ? "Study Mode" : "Reading Mode";
            }
          });
        };

        const applyTheme = (theme, persist = true) => {
          const nextTheme = theme === "dark" ? "dark" : "light";
          root.dataset.theme = nextTheme;
          if (persist) {
            writeStoredTheme(nextTheme);
          }
          updateButtons(nextTheme);
        };

        const toggleTheme = () => {
          const nextTheme = root.dataset.theme === "dark" ? "light" : "dark";
          applyTheme(nextTheme);
        };

        const applyReaderMode = (mode, persist = true) => {
          const nextMode = mode === "read" ? "read" : "study";
          root.dataset.readerMode = nextMode;
          if (persist) {
            writeStoredReaderMode(nextMode);
          }
          updateReaderButtons(nextMode);
          document.dispatchEvent(
            new CustomEvent("site:reader-mode-change", {
              detail: { mode: nextMode },
            })
          );
        };

        const toggleReaderMode = () => {
          const nextMode = root.dataset.readerMode === "read" ? "study" : "read";
          applyReaderMode(nextMode);
        };

        const showReaderNotice = (message) => {
          let notice = document.querySelector("[data-reader-notice]");
          if (!(notice instanceof HTMLElement)) {
            notice = document.createElement("div");
            notice.setAttribute("data-reader-notice", "");
            notice.className = "reader-notice";
            notice.setAttribute("role", "status");
            notice.setAttribute("aria-live", "polite");
            document.body.appendChild(notice);
          }
          notice.textContent = message;
          // Force a reflow so re-triggering replays the transition.
          void notice.offsetWidth;
          notice.classList.add("is-visible");
          window.clearTimeout(Number(notice.dataset.hideTimer || 0));
          notice.dataset.hideTimer = String(
            window.setTimeout(() => notice.classList.remove("is-visible"), 6000)
          );
        };

        // A Scripture reference link (?ref=...) cannot be highlighted in Reading
        // Mode because proof texts are hidden there. Override to Study Mode for
        // this view—without clobbering the saved preference—and let the reader know.
        // Only act once per arrival: switching the reader toggle re-renders the
        // confession (firing astro:page-load), so without this guard a manual
        // switch back to Reading Mode would immediately be forced to Study again.
        let lastReferenceHref = "";
        const forceStudyModeForReference = () => {
          try {
            const href = window.location.href;
            if (href === lastReferenceHref) {
              return;
            }
            const params = new URLSearchParams(window.location.search);
            if (!params.get("ref")) {
              return;
            }
            if (!document.querySelector("[data-confession]")) {
              return;
            }
            // Mark this page view handled before switching modes so the resulting
            // re-render does not re-trigger the override.
            lastReferenceHref = href;
            if (root.dataset.readerMode !== "read") {
              return;
            }
            applyReaderMode("study", false);
            showReaderNotice(
              "View changed from Reading to Study Mode since you clicked a Scripture reference."
            );
          } catch {
            // ignore
          }
        };

        // Phones: the menu button opens the header controls as a panel, and the
        // header slides out of the way while reading down the page.
        const setMenuOpen = (open) => {
          root.classList.toggle("menu-open", open);
          document.querySelectorAll("[data-menu-toggle]").forEach((button) => {
            button.setAttribute("aria-expanded", open ? "true" : "false");
          });
        };

        const initPhoneHeader = () => {
          const header = document.querySelector(".top");
          if (!(header instanceof HTMLElement)) {
            return;
          }
          let lastY = window.scrollY;
          window.addEventListener(
            "scroll",
            () => {
              const y = window.scrollY;
              const delta = y - lastY;
              if (Math.abs(delta) < 6) {
                return;
              }
              const hide =
                delta > 0 && y > header.offsetHeight && !root.classList.contains("menu-open");
              header.classList.toggle("is-tucked", hide);
              lastY = y;
            },
            { passive: true }
          );
          document.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && root.classList.contains("menu-open")) {
              setMenuOpen(false);
            }
          });
        };

        const init = () => {
          applyTheme(readStoredTheme() || root.dataset.theme || "light", false);
          applyReaderMode(readStoredReaderMode(), false);
          forceStudyModeForReference();
          document.addEventListener("astro:page-load", forceStudyModeForReference);
          initPhoneHeader();
          document.addEventListener("click", (event) => {
            const target = event.target instanceof Element ? event.target : null;
            if (!target) {
              return;
            }

            const menuTrigger = target.closest("[data-menu-toggle]");
            if (menuTrigger) {
              setMenuOpen(!root.classList.contains("menu-open"));
              return;
            }
            if (root.classList.contains("menu-open") && !target.closest("[data-site-menu]")) {
              setMenuOpen(false);
            }

            const themeTrigger = target.closest("[data-theme-toggle]");
            if (themeTrigger) {
              event.preventDefault();
              toggleTheme();
              return;
            }

            const readerTrigger = target.closest("[data-reader-toggle]");
            if (readerTrigger) {
              event.preventDefault();
              toggleReaderMode();
            }
          });
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", init, { once: true });
        } else {
          init();
        }
      })();
    </script>
  </body>
</html>

<style>
  .top {
    display: flex;
    position: sticky;
    top: 0;
    z-index: 1000;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--surface-border);
    background: var(--color-nav-bg);
    backdrop-filter: blur(8px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    color: var(--color-heading);
    text-decoration: none;
  }

  .brand-logo {
    width: 3.25rem;
    height: 3.25rem;
    flex: 0 0 auto;
    object-fit: contain;
  }

  nav {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    align-items: center;
  }

  nav a {
    color: var(--color-link);
    text-decoration: none;
  }

  .theme-toggle {
    margin-left: 0;
  }

  .header-controls {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  main {
    padding: 1rem 1rem 2.2rem;
    max-width: 1120px;
    margin: 0 auto;
  }

  .menu-toggle,
  .menu-links,
  .header-bible,
  .tabbar {
    display: none;
  }

  /* Phones: one slim header row (logo + menu), the main links in a bottom tab
     bar, and the header controls in a panel behind the menu button. */
  @media (max-width: 720px) {
    .top {
      flex-wrap: nowrap;
      padding: 0.35rem 0.75rem;
      transition: transform 0.2s ease-out;
    }

    .top.is-tucked {
      transform: translateY(-100%);
    }

    .brand-logo {
      width: 2.25rem;
      height: 2.25rem;
    }

    .top-nav {
      display: none;
    }

    .menu-toggle {
      display: inline-grid;
      place-items: center;
      margin-left: auto;
      width: 2.5rem;
      height: 2.5rem;
      padding: 0;
      border-radius: 10px;
      border: 1px solid transparent;
      background: transparent;
      color: var(--color-text);
    }

    /* Phones keep a Bible link in the slim header, beside the menu button. */
    .header-bible {
      display: inline-flex;
      align-items: center;
      margin-left: auto;
      padding: 0.4rem 0.6rem;
      color: var(--color-link);
      font-weight: 600;
      text-decoration: none;
    }

    .header-bible + .menu-toggle {
      margin-left: 0.25rem;
    }

    .menu-toggle[aria-expanded="true"] {
      border-color: var(--surface-border);
      background: var(--surface-bg-muted);
    }

    .menu-toggle svg,
    .tabbar svg {
      width: 1.35rem;
      height: 1.35rem;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .header-controls {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      margin: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0.6rem;
      padding: 0.9rem 1rem 1.1rem;
      background: var(--card-bg);
      border-bottom: 1px solid var(--surface-border-strong);
      box-shadow: var(--shadow-card);
    }

    :global(html.menu-open) .header-controls {
      display: flex;
    }

    .menu-links {
      display: flex;
      flex-direction: column;
      border-top: 1px solid var(--surface-border);
      margin-top: 0.2rem;
    }

    .menu-links a {
      padding: 0.7rem 0.15rem;
      border-bottom: 1px solid var(--surface-border);
      color: var(--color-text);
      text-decoration: none;
    }

    .menu-links a:last-child {
      border-bottom: 0;
    }

    .tabbar {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 1000;
      padding-bottom: env(safe-area-inset-bottom, 0px);
      background: var(--color-nav-bg);
      border-top: 1px solid var(--surface-border);
      backdrop-filter: blur(8px);
    }

    .tabbar a {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.15rem;
      min-height: 3.6rem;
      font-size: 0.72rem;
      color: var(--color-muted);
      text-decoration: none;
    }

    .tabbar a[aria-current="page"] {
      color: var(--color-link);
      font-weight: 700;
    }

    :global(body) {
      padding-bottom: calc(3.6rem + env(safe-area-inset-bottom, 0px));
    }
  }

</style>
