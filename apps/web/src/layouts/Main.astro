---
import { siteSettings } from "../lib/siteSettings";
import Footer from "../components/Footer.astro";
import AppInstall from "../components/AppInstall.astro";

const { title = siteSettings.siteName } = Astro.props;
const gaMeasurementId = siteSettings.analytics.googleAnalyticsMeasurementId;
const siteDescription = "Search and read historic Christian confessions with their Scripture references.";
const logoUrl = "/logo.svg";
const siteUrl = "https://confess.catechize.ing";
const ogImageUrl = `${siteUrl}/ogLogo.png`;
// Register the service worker only in built output, so dev HMR isn't intercepted.
const enablePwa = import.meta.env.PROD;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={siteDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={`${siteSettings.siteName} social preview`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <link rel="icon" href="/favicon.ico" />
    <meta name="theme-color" content="#e6eee6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1712" media="(prefers-color-scheme: dark)" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Confessions Hub" />
    <title>{title}</title>
    {enablePwa ? (
      <script is:inline>
        if ("serviceWorker" in navigator) {
          window.addEventListener("load", () => {
            navigator.serviceWorker.register("/sw.js").catch(() => {});
          });
        }
      </script>
    ) : null}
    {siteSettings.analytics.enabled ? (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script is:inline define:vars={{ gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag("js", new Date());
          gtag("config", gaMeasurementId, {
            anonymize_ip: true,
          });
        </script>
      </>
    ) : null}
    <script is:inline>
      (() => {
        const storageKey = "site-theme";
        const readerStorageKey = "site-reader-mode";
        const root = document.documentElement;

        const readStoredTheme = () => {
          try {
            const value = window.localStorage.getItem(storageKey);
            return value === "light" || value === "dark" ? value : null;
          } catch {
            return null;
          }
        };

        const readStoredReaderMode = () => {
          try {
            const value = window.localStorage.getItem(readerStorageKey);
            return value === "read" || value === "study" ? value : null;
          } catch {
            return null;
          }
        };

        const prefersDark = () => {
          if (typeof window.matchMedia !== "function") {
            return null;
          }
          try {
            return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          } catch {
            return null;
          }
        };

        root.dataset.theme = readStoredTheme() || prefersDark() || "light";
        root.dataset.readerMode = readStoredReaderMode() || "study";
      })();
    </script>
    <link rel="stylesheet" href="/styles/theme.css" />
  </head>
  <body>
    <header class="top">
      <a href="/" class="brand" aria-label={`${siteSettings.siteName} home`}>
        <img src={logoUrl} alt="" class="brand-logo" width="96" height="96" />
      </a>
      <nav>
        <a href="/confessions">Confessions</a>
        <a href="/scriptures">Scriptures</a>
        <a href="/bible/gen/1">Bible</a>
      </nav>
      <div class="header-controls">
        <AppInstall />
        <button type="button" class="reader-toggle" data-reader-toggle aria-label="Toggle reading mode">
          <span data-reader-toggle-label>Reading Mode</span>
        </button>
        <button type="button" class="theme-toggle" data-theme-toggle aria-label="Toggle color theme">
          <span data-theme-toggle-label>Dark</span>
        </button>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (() => {
        const storageKey = "site-theme";
        const readerStorageKey = "site-reader-mode";
        const root = document.documentElement;

        const readStoredTheme = () => {
          try {
            const value = window.localStorage.getItem(storageKey);
            return value === "light" || value === "dark" ? value : null;
          } catch {
            return null;
          }
        };

        const writeStoredTheme = (theme) => {
          try {
            window.localStorage.setItem(storageKey, theme);
          } catch {
            // ignore
          }
        };

        const readStoredReaderMode = () => {
          try {
            const value = window.localStorage.getItem(readerStorageKey);
            return value === "read" || value === "study" ? value : "study";
          } catch {
            return "study";
          }
        };

        const writeStoredReaderMode = (mode) => {
          try {
            window.localStorage.setItem(readerStorageKey, mode);
          } catch {
            // ignore
          }
        };

        const updateButtons = (theme) => {
          document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
            button.setAttribute("aria-pressed", theme === "dark" ? "true" : "false");
            const label = button.querySelector("[data-theme-toggle-label]");
            if (label) {
              label.textContent = theme === "dark" ? "Light" : "Dark";
            }
          });
        };

        const updateReaderButtons = (mode) => {
          document.querySelectorAll("[data-reader-toggle]").forEach((button) => {
            button.setAttribute("aria-pressed", mode === "read" ? "true" : "false");
            const label = button.querySelector("[data-reader-toggle-label]");
            if (label) {
              // Action-style label: show the mode the click will activate.
              label.textContent = mode === "read" ? "Study Mode" : "Reading Mode";
            }
          });
        };

        const applyTheme = (theme, persist = true) => {
          const nextTheme = theme === "dark" ? "dark" : "light";
          root.dataset.theme = nextTheme;
          if (persist) {
            writeStoredTheme(nextTheme);
          }
          updateButtons(nextTheme);
        };

        const toggleTheme = () => {
          const nextTheme = root.dataset.theme === "dark" ? "light" : "dark";
          applyTheme(nextTheme);
        };

        const applyReaderMode = (mode, persist = true) => {
          const nextMode = mode === "read" ? "read" : "study";
          root.dataset.readerMode = nextMode;
          if (persist) {
            writeStoredReaderMode(nextMode);
          }
          updateReaderButtons(nextMode);
          document.dispatchEvent(
            new CustomEvent("site:reader-mode-change", {
              detail: { mode: nextMode },
            })
          );
        };

        const toggleReaderMode = () => {
          const nextMode = root.dataset.readerMode === "read" ? "study" : "read";
          applyReaderMode(nextMode);
        };

        const showReaderNotice = (message) => {
          let notice = document.querySelector("[data-reader-notice]");
          if (!(notice instanceof HTMLElement)) {
            notice = document.createElement("div");
            notice.setAttribute("data-reader-notice", "");
            notice.className = "reader-notice";
            notice.setAttribute("role", "status");
            notice.setAttribute("aria-live", "polite");
            document.body.appendChild(notice);
          }
          notice.textContent = message;
          // Force a reflow so re-triggering replays the transition.
          void notice.offsetWidth;
          notice.classList.add("is-visible");
          window.clearTimeout(Number(notice.dataset.hideTimer || 0));
          notice.dataset.hideTimer = String(
            window.setTimeout(() => notice.classList.remove("is-visible"), 6000)
          );
        };

        // A Scripture reference link (?ref=...) cannot be highlighted in Reading
        // Mode because proof texts are hidden there. Override to Study Mode for
        // this view—without clobbering the saved preference—and let the reader know.
        // Only act once per arrival: switching the reader toggle re-renders the
        // confession (firing astro:page-load), so without this guard a manual
        // switch back to Reading Mode would immediately be forced to Study again.
        let lastReferenceHref = "";
        const forceStudyModeForReference = () => {
          try {
            const href = window.location.href;
            if (href === lastReferenceHref) {
              return;
            }
            const params = new URLSearchParams(window.location.search);
            if (!params.get("ref")) {
              return;
            }
            if (!document.querySelector("[data-confession]")) {
              return;
            }
            // Mark this page view handled before switching modes so the resulting
            // re-render does not re-trigger the override.
            lastReferenceHref = href;
            if (root.dataset.readerMode !== "read") {
              return;
            }
            applyReaderMode("study", false);
            showReaderNotice(
              "View changed from Reading to Study Mode since you clicked a Scripture reference."
            );
          } catch {
            // ignore
          }
        };

        const init = () => {
          applyTheme(readStoredTheme() || root.dataset.theme || "light", false);
          applyReaderMode(readStoredReaderMode(), false);
          forceStudyModeForReference();
          document.addEventListener("astro:page-load", forceStudyModeForReference);
          document.addEventListener("click", (event) => {
            const target = event.target instanceof Element ? event.target : null;
            if (!target) {
              return;
            }

            const themeTrigger = target.closest("[data-theme-toggle]");
            if (themeTrigger) {
              event.preventDefault();
              toggleTheme();
              return;
            }

            const readerTrigger = target.closest("[data-reader-toggle]");
            if (readerTrigger) {
              event.preventDefault();
              toggleReaderMode();
            }
          });
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", init, { once: true });
        } else {
          init();
        }
      })();
    </script>
  </body>
</html>

<style>
  .top {
    display: flex;
    position: sticky;
    top: 0;
    z-index: 1000;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--surface-border);
    background: var(--color-nav-bg);
    backdrop-filter: blur(8px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    color: var(--color-heading);
    text-decoration: none;
  }

  .brand-logo {
    width: 3.25rem;
    height: 3.25rem;
    flex: 0 0 auto;
    object-fit: contain;
  }

  nav {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    align-items: center;
  }

  nav a {
    color: var(--color-link);
    text-decoration: none;
  }

  .theme-toggle {
    margin-left: 0;
  }

  .header-controls {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  main {
    padding: 1rem 1rem 2.2rem;
    max-width: 1120px;
    margin: 0 auto;
  }

  @media (max-width: 720px) {
    .header-controls {
      margin-left: 0;
    }
  }

</style>
