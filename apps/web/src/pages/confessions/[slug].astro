---
import Main from "../../layouts/Main.astro";
import BibleReferencesScript from "../../components/BibleReferencesScript.astro";
import ConfessionReferenceHighlightScript from "../../components/ConfessionReferenceHighlightScript.astro";
import {
  findConfession,
  getConfessionDisplayUnits,
  listConfessions,
  usesParagraphNumbers,
} from "../../lib/confessions";
import { autoLinkBibleRefs } from "../../lib/bible/autoLinkBibleRefs";
import { normalizeReference } from "../../lib/bible/normalizeRef";
import { getVerseLookup } from "../../lib/bible/bibleData";

export function getStaticPaths() {
  return listConfessions().map((item) => ({
    params: { slug: item.slug },
  }));
}

const { slug } = Astro.params;
const confession = findConfession(String(slug));

if (!confession) {
  return Astro.redirect("/confessions");
}

const unitId = (number: number) => `unit-${number}`;
const paragraphId = (unitNumber: number, paragraphNumber: number) =>
  `para-${unitNumber}-${paragraphNumber}`;
const displayUnits = getConfessionDisplayUnits(confession);
const showParagraphMeta = usesParagraphNumbers(confession.slug);
const proofTagPattern = /\{\{proofs:\s*([^}]+?)\s*\}\}/gi;

function hasProofTags(value: string): boolean {
  return /\{\{proofs:\s*[^}]+?\s*\}\}/i.test(value);
}

function renderParagraphFromProofTags(value: string, readerModeEnabled: boolean): string {
  const source = String(value ?? "");
  if (readerModeEnabled) {
    return source
      .replace(proofTagPattern, "")
      .replace(/\s{2,}/g, " ")
      .replace(/\s+([,.;:!?])/g, "$1")
      .trim();
  }

  return source.replace(proofTagPattern, "($1)");
}

const references = new Set<string>();
for (const unit of displayUnits) {
  for (const paragraph of unit.content) {
    const linkedParagraph = autoLinkBibleRefs(renderParagraphFromProofTags(paragraph, false));
    const matches = [...linkedParagraph.matchAll(/data-ref="([^"]+)"/g)];
    matches.forEach((match) => {
      const reference = normalizeReference(String(match[1] ?? "").trim());
      if (reference) {
        references.add(reference);
      }
    });
  }
}

const verseLookup = await getVerseLookup([...references]);
---

<Main title={confession.title}>
  <div class="confession-page" id="confession-top" data-confession={confession.slug}>
    <section class="confession-header">
      <h1>
        <span class="confession-badge">{confession.shortCode}</span>
        <span>{confession.title}</span>
      </h1>
      <p class="confession-meta-line">
        <a class="confession-link" href={`/confessions/${confession.slug}/about`}>About this confession</a>
      </p>
    </section>

    <section class="tools">
      <div class="tool-control">
        <label for="unit-select">Jump to chapter</label>
        <select id="unit-select">
          <option value="">Select a chapter</option>
          {displayUnits.map((unit) => (
            <option value={unitId(unit.number)}>
              {confession.unitLabel} {unit.number}: {unit.title}
            </option>
          ))}
        </select>
      </div>
      <div class="tool-control">
        <label for="unit-filter">Filter paragraphs</label>
        <input
          id="unit-filter"
          type="search"
          placeholder="Search—Use quotes for exact phrase like &quot;the church&quot;"
          title="Use quotes for exact phrase like &quot;the church&quot;"
          autocomplete="off"
        />
      </div>
      <p id="unit-results-meta" class="meta">{displayUnits.length} total</p>
    </section>

    <p id="unit-no-results" hidden>No paragraphs matched that filter.</p>

    {displayUnits.map((unit) => (
      <section class="unit" id={unitId(unit.number)}>
        <h2 class="unit-title">{confession.unitLabel} {unit.number}: {unit.title}</h2>
        <div class="paragraph-list">
          {unit.content.map((paragraph, index) => (
            <article
              class="paragraph-card card-panel"
              id={paragraphId(unit.number, index + 1)}
              data-bible-autolink
              data-paragraph-card
              data-proof-source={hasProofTags(paragraph) ? paragraph : undefined}
              data-paragraph-ref={`${confession.shortCode} ${confession.unitLabel} ${unit.number}${
                showParagraphMeta ? `, Paragraph ${index + 1}` : ""
              }`}
            >
              <button
                type="button"
                class="paragraph-share"
                data-paragraph-share
                aria-label={`Copy or share ${confession.unitLabel} ${unit.number}${
                  showParagraphMeta ? `, Paragraph ${index + 1}` : ""
                }`}
                title="Copy or share this paragraph"
              >
                <svg class="paragraph-share-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M12 3v12" />
                  <path d="m8 7 4-4 4 4" />
                  <path d="M5 13v6a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-6" />
                </svg>
              </button>
              {showParagraphMeta ? (
                <p class="paragraph-meta">{confession.unitLabel} {unit.number} - Paragraph {index + 1}</p>
              ) : null}
              <p>{renderParagraphFromProofTags(paragraph, false)}</p>
            </article>
          ))}
        </div>
        <p class="unit-back-to-top">
          <a href="#confession-top">Back to top</a>
        </p>
      </section>
    ))}

    <div
      class="para-actionbar"
      data-para-actionbar
      hidden
      role="region"
      aria-label="Paragraph actions"
    >
      <div class="para-actionbar-inner">
        <button
          type="button"
          class="para-actionbar-switch"
          data-para-refs
          role="switch"
          aria-checked="true"
          aria-label="Include Scripture references when copying or sharing"
          title="Include Scripture references when copying or sharing"
        >
          <span class="para-actionbar-switch-track" aria-hidden="true">
            <span class="para-actionbar-switch-thumb"></span>
          </span>
          <span>Refs</span>
        </button>
        <button type="button" class="para-actionbar-button" data-para-copy>Copy</button>
        <button type="button" class="para-actionbar-button" data-para-share hidden>Share</button>
        <button
          type="button"
          class="para-actionbar-button para-actionbar-clear"
          data-para-close
          aria-label="Close"
        >
          ✕
        </button>
      </div>
    </div>
  </div>
</Main>

<BibleReferencesScript verseLookup={verseLookup} />
<ConfessionReferenceHighlightScript />

<script>
  const confessionPage = document.querySelector(".confession-page");
  const root = document.documentElement;
  const input = document.getElementById("unit-filter");
  const unitSelect = document.getElementById("unit-select");
  const meta = document.getElementById("unit-results-meta");
  const noResults = document.getElementById("unit-no-results");
  const units = Array.from(document.querySelectorAll(".unit"));
  const paragraphCards = Array.from(document.querySelectorAll("[data-paragraph-card]"));

  const escapeRegExp = (value) => value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

  const getParagraphBodies = () =>
    Array.from(document.querySelectorAll(".paragraph-card p:last-child"));

  const parseSearchTerms = (rawQuery) => {
    const terms = [];
    const query = String(rawQuery ?? "");
    const phraseRegex = /"([^"]+)"/g;
    let remaining = query;

    for (const match of query.matchAll(phraseRegex)) {
      const phrase = String(match[1] ?? "").trim();
      if (phrase) {
        terms.push(phrase);
      }
      remaining = remaining.replace(String(match[0] ?? ""), " ");
    }

    remaining
      .trim()
      .split(/\s+/)
      .map((token) => token.trim())
      .filter(Boolean)
      .forEach((token) => terms.push(token));

    return [...new Set(terms.map((term) => term.toLowerCase()))];
  };

  const clearHighlights = (root) => {
    const marks = Array.from(root.querySelectorAll("mark.search-hit"));
    marks.forEach((mark) => {
      const parent = mark.parentNode;
      if (!parent) {
        return;
      }
      parent.replaceChild(document.createTextNode(mark.textContent || ""), mark);
      parent.normalize();
    });
  };

  const highlightInNode = (node, regex) => {
    const text = node.nodeValue || "";
    const matches = Array.from(text.matchAll(regex));
    if (matches.length === 0) {
      return;
    }

    const fragment = document.createDocumentFragment();
    let cursor = 0;

    matches.forEach((match) => {
      const index = match.index ?? 0;
      const hit = match[0] ?? "";
      if (!hit) {
        return;
      }

      if (index > cursor) {
        fragment.appendChild(document.createTextNode(text.slice(cursor, index)));
      }

      const mark = document.createElement("mark");
      mark.className = "search-hit";
      mark.textContent = hit;
      fragment.appendChild(mark);
      cursor = index + hit.length;
    });

    if (cursor < text.length) {
      fragment.appendChild(document.createTextNode(text.slice(cursor)));
    }

    node.parentNode?.replaceChild(fragment, node);
  };

  const highlightMatches = (rawQuery) => {
    const paragraphBodies = getParagraphBodies();
    paragraphBodies.forEach((paragraph) => {
      if (!(paragraph instanceof HTMLElement)) {
        return;
      }

      clearHighlights(paragraph);
    });

    const terms = parseSearchTerms(rawQuery);

    if (terms.length === 0) {
      return;
    }

    const pattern = terms
      .map((term) => escapeRegExp(term))
      .sort((a, b) => b.length - a.length)
      .join("|");

    if (!pattern) {
      return;
    }

    const regex = new RegExp(pattern, "gi");

    paragraphBodies.forEach((paragraph) => {
      if (!(paragraph instanceof HTMLElement)) {
        return;
      }

      const walker = document.createTreeWalker(paragraph, NodeFilter.SHOW_TEXT, {
        acceptNode: (node) => {
          const value = node.nodeValue || "";
          if (!value.trim()) {
            return NodeFilter.FILTER_REJECT;
          }

          const parent = node.parentElement;
          if (!parent || parent.closest("mark.search-hit")) {
            return NodeFilter.FILTER_REJECT;
          }

          regex.lastIndex = 0;
          return regex.test(value) ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
        },
      });

      const textNodes = [];
      while (walker.nextNode()) {
        textNodes.push(walker.currentNode);
      }

      textNodes.forEach((node) => {
        regex.lastIndex = 0;
        highlightInNode(node, regex);
      });
    });
  };

  const renderParagraphFromProofTagsClient = (source, enabled) => {
    const raw = String(source ?? "");
    if (enabled) {
      return raw
        .replace(/\{\{proofs:\s*([^}]+?)\s*\}\}/gi, "")
        .replace(/\s{2,}/g, " ")
        .replace(/\s+([,.;:!?])/g, "$1")
        .trim();
    }
    return raw.replace(/\{\{proofs:\s*([^}]+?)\s*\}\}/gi, "($1)");
  };

  // --- Copy / share a paragraph ---
  // Mirrors the Bible reader's verse action bar. The switch controls the inline
  // Scripture references, which is the thing that differs between wanting the
  // confession's prose and wanting its proof texts; the citation and a link to
  // the paragraph are always included so a pasted quote can be traced back.
  (() => {
    const actionBar = document.querySelector("[data-para-actionbar]");
    const refsButton = document.querySelector("[data-para-refs]");
    const copyButton = document.querySelector("[data-para-copy]");
    const shareButton = document.querySelector("[data-para-share]");
    const closeButton = document.querySelector("[data-para-close]");
    const refsStorageKey = "confession-copy-include-refs";

    if (!(actionBar instanceof HTMLElement)) {
      return;
    }

    const readIncludeRefs = () => {
      try {
        return window.localStorage.getItem(refsStorageKey) !== "0";
      } catch {
        return true;
      }
    };

    const writeIncludeRefs = (value) => {
      try {
        window.localStorage.setItem(refsStorageKey, value ? "1" : "0");
      } catch {
        // preference is best-effort; the toggle still works this session
      }
    };

    let includeRefs = readIncludeRefs();
    let activeCard = null;
    const feedbackTimers = new WeakMap();

    const getHeaderOffset = () => {
      const header = document.querySelector(".top");
      return header instanceof HTMLElement ? Math.ceil(header.getBoundingClientRect().height) : 0;
    };

    const getParagraphText = (card) => {
      const source = card.dataset.proofSource;
      if (source) {
        // `enabled` means reader mode, i.e. strip the references.
        return renderParagraphFromProofTagsClient(source, !includeRefs);
      }
      // No proof tags: the rendered body is the whole paragraph either way.
      const body = card.querySelector("p:last-child");
      return (body?.textContent || "").trim();
    };

    const getShareUrl = (card) => {
      const url = new URL(window.location.pathname, window.location.origin);
      if (card.id) {
        url.hash = card.id;
      }
      return url.toString();
    };

    const buildShareText = (card) =>
      [String(card.dataset.paragraphRef || "").trim(), getParagraphText(card)]
        .filter(Boolean)
        .join("\n");

    const positionActionBar = () => {
      if (!(activeCard instanceof HTMLElement) || actionBar.hidden) {
        return;
      }

      const margin = 8;
      const gap = 8;
      const headerOffset = getHeaderOffset();
      const cardRect = activeCard.getBoundingClientRect();
      const barWidth = actionBar.offsetWidth;
      const barHeight = actionBar.offsetHeight;

      let top = cardRect.top - gap - barHeight;
      if (top < headerOffset + margin) {
        top = Math.min(cardRect.top + gap, window.innerHeight - margin - barHeight);
        top = Math.max(top, headerOffset + margin);
      }

      let left = cardRect.right - barWidth;
      if (left + barWidth > window.innerWidth - margin) {
        left = window.innerWidth - margin - barWidth;
      }
      if (left < margin) {
        left = margin;
      }

      actionBar.style.top = `${Math.round(top)}px`;
      actionBar.style.left = `${Math.round(left)}px`;
    };

    const render = () => {
      for (const card of Array.from(document.querySelectorAll(".paragraph-card.is-sharing"))) {
        card.classList.remove("is-sharing");
      }

      if (!(activeCard instanceof HTMLElement)) {
        actionBar.hidden = true;
        return;
      }

      activeCard.classList.add("is-sharing");
      actionBar.hidden = false;
      if (refsButton instanceof HTMLButtonElement) {
        refsButton.setAttribute("aria-checked", includeRefs ? "true" : "false");
        // A paragraph with no proof tags has nothing to toggle.
        refsButton.hidden = !activeCard.dataset.proofSource;
      }
      positionActionBar();
    };

    const close = () => {
      activeCard = null;
      render();
    };

    const setFeedback = (trigger, label) => {
      const previous = feedbackTimers.get(trigger);
      if (previous) {
        window.clearTimeout(previous);
      }
      if (!trigger.dataset.defaultLabel) {
        trigger.dataset.defaultLabel = trigger.textContent || "";
      }
      trigger.textContent = label;
      feedbackTimers.set(
        trigger,
        window.setTimeout(() => {
          trigger.textContent = trigger.dataset.defaultLabel || "";
          feedbackTimers.delete(trigger);
        }, 1400)
      );
    };

    const copyText = async (value) => {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(value);
        return;
      }
      const textArea = document.createElement("textarea");
      textArea.value = value;
      textArea.setAttribute("readonly", "");
      textArea.style.position = "fixed";
      textArea.style.left = "-9999px";
      document.body.appendChild(textArea);
      textArea.select();
      try {
        document.execCommand("copy");
      } finally {
        textArea.remove();
      }
    };

    document.addEventListener("click", (event) => {
      const trigger = event.target instanceof Element
        ? event.target.closest("[data-paragraph-share]")
        : null;
      if (!(trigger instanceof HTMLElement)) {
        return;
      }
      event.preventDefault();
      const card = trigger.closest("[data-paragraph-card]");
      if (!(card instanceof HTMLElement)) {
        return;
      }
      activeCard = activeCard === card ? null : card;
      render();
    });

    if (refsButton instanceof HTMLButtonElement) {
      refsButton.addEventListener("click", () => {
        includeRefs = !includeRefs;
        writeIncludeRefs(includeRefs);
        render();
      });
    }

    if (copyButton instanceof HTMLButtonElement) {
      copyButton.addEventListener("click", async () => {
        if (!(activeCard instanceof HTMLElement)) {
          return;
        }
        const value = [buildShareText(activeCard), getShareUrl(activeCard)].join("\n");
        try {
          await copyText(value);
          setFeedback(copyButton, "Copied!");
        } catch {
          setFeedback(copyButton, "Failed");
        }
      });
    }

    if (shareButton instanceof HTMLButtonElement && navigator.share) {
      shareButton.hidden = false;
      shareButton.addEventListener("click", async () => {
        if (!(activeCard instanceof HTMLElement)) {
          return;
        }
        try {
          await navigator.share({
            title: String(activeCard.dataset.paragraphRef || "").trim() || "Confession paragraph",
            text: buildShareText(activeCard),
            url: getShareUrl(activeCard),
          });
        } catch {
          // dismissed or unavailable; leave the selection alone
        }
      });
    }

    if (closeButton instanceof HTMLButtonElement) {
      closeButton.addEventListener("click", close);
    }

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && activeCard) {
        close();
      }
    });

    window.addEventListener("scroll", positionActionBar, { passive: true });
    window.addEventListener("resize", positionActionBar);
  })();

  const applyReaderModeToTaggedParagraphs = (enabled) => {
    const taggedCards = Array.from(document.querySelectorAll("[data-proof-source]"));
    taggedCards.forEach((card) => {
      if (!(card instanceof HTMLElement)) {
        return;
      }

      const source = card.dataset.proofSource;
      if (!source) {
        return;
      }

      const paragraph = card.querySelector("p:last-child");
      if (!(paragraph instanceof HTMLElement)) {
        return;
      }

      paragraph.textContent = renderParagraphFromProofTagsClient(source, enabled);
      card.dataset.bibleProcessed = "false";
    });

    document.dispatchEvent(new Event("astro:page-load"));
    if (input instanceof HTMLInputElement) {
      window.setTimeout(() => highlightMatches(input.value), 0);
    }
  };

  const setReaderMode = (enabled) => {
    if (!(confessionPage instanceof HTMLElement)) {
      return;
    }

    applyReaderModeToTaggedParagraphs(enabled);
    confessionPage.classList.toggle("reader-mode-enabled", enabled);
  };

  const applyFromGlobalMode = (mode) => {
    setReaderMode(mode === "read");
    if (input instanceof HTMLInputElement) {
      input.dispatchEvent(new Event("input", { bubbles: true }));
    }
  };

  applyFromGlobalMode(root.dataset.readerMode || "study");
  document.addEventListener("site:reader-mode-change", (event) => {
    const mode = event instanceof CustomEvent ? String(event.detail?.mode || "study") : "study";
    applyFromGlobalMode(mode);
  });

  const scrollToConfessionTop = () => {
    if (!(confessionPage instanceof HTMLElement)) {
      return;
    }

    const header = document.querySelector(".top");
    const headerHeight = header instanceof HTMLElement ? header.getBoundingClientRect().height : 0;
    const targetTop = window.scrollY + confessionPage.getBoundingClientRect().top - headerHeight - 12;

    window.scrollTo({
      top: Math.max(targetTop, 0),
      behavior: "smooth",
    });
  };

  document.addEventListener("click", (event) => {
    const target = event.target instanceof Element ? event.target : null;
    const topLink = target?.closest('a[href="#confession-top"]');
    if (!(topLink instanceof HTMLAnchorElement)) {
      return;
    }

    event.preventDefault();
    scrollToConfessionTop();
    if (window.location.hash !== "#confession-top") {
      window.history.replaceState(null, "", "#confession-top");
    }
  });

  if (unitSelect instanceof HTMLSelectElement) {
    unitSelect.addEventListener("change", () => {
      const targetId = unitSelect.value;
      if (!targetId) {
        return;
      }

      if (input instanceof HTMLInputElement && input.value) {
        input.value = "";
        input.dispatchEvent(new Event("input", { bubbles: true }));
      }

      const target = document.getElementById(targetId);
      if (!(target instanceof HTMLElement)) {
        return;
      }

      const header = document.querySelector(".top");
      const headerHeight = header instanceof HTMLElement ? header.getBoundingClientRect().height : 0;
      const targetTop = window.scrollY + target.getBoundingClientRect().top - headerHeight - 18;

      window.scrollTo({
        top: Math.max(targetTop, 0),
        behavior: "smooth",
      });
      window.history.replaceState(null, "", `#${targetId}`);
    });
  }

  if (input instanceof HTMLInputElement && meta && noResults) {
    const totalParagraphs = paragraphCards.length;

    const applyFilter = () => {
      const rawQuery = input.value.trim();
      const terms = parseSearchTerms(rawQuery);
      let visibleParagraphs = 0;
      const visibleUnitIds = new Set<string>();

      for (const paragraphCard of paragraphCards) {
        if (!(paragraphCard instanceof HTMLElement)) {
          continue;
        }

        const paragraphBody = paragraphCard.querySelector("p:last-child");
        const text = (paragraphBody?.textContent ?? "").toLowerCase();
        const match = terms.length === 0 || terms.every((term) => text.includes(term));
        paragraphCard.hidden = !match;

        if (match) {
          visibleParagraphs += 1;
          const unit = paragraphCard.closest(".unit");
          if (unit instanceof HTMLElement && unit.id) {
            visibleUnitIds.add(unit.id);
          }
        }
      }

      for (const unit of units) {
        if (!(unit instanceof HTMLElement)) {
          continue;
        }
        unit.hidden = !visibleUnitIds.has(unit.id);
      }

      meta.textContent = terms.length > 0
        ? `${visibleParagraphs} of ${totalParagraphs} paragraphs shown`
        : `${totalParagraphs} paragraphs total`;
      noResults.hidden = terms.length === 0 || visibleParagraphs !== 0;
      highlightMatches(rawQuery);
    };

    input.addEventListener("input", applyFilter);
    applyFilter();
  }
</script>

<style>
  .confession-page {
    border: 1px solid var(--confession-accent-border, var(--surface-border));
    border-radius: 14px;
    padding: 0.8rem;
    scroll-margin-top: 7.5rem;
    background: color-mix(in srgb, var(--confession-accent-bg, transparent) 24%, transparent);
  }

  .tools {
    display: grid;
    grid-template-columns: minmax(12rem, 18rem) minmax(14rem, 1fr);
    gap: 0.75rem 1rem;
    align-items: end;
    margin-bottom: 1rem;
    border: 1px solid var(--confession-accent-border, var(--surface-border));
    border-radius: 10px;
    background: var(--confession-accent-bg, var(--surface-bg-muted));
    padding: 0.75rem;
  }

  .tool-control {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }

  .confession-header h1 {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 0.3rem;
  }

  .confession-header p {
    margin-top: 0;
  }

  .confession-meta-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    align-items: center;
  }

  #unit-select,
  input[type="search"] {
    width: 100%;
    box-sizing: border-box;
  }

  .meta {
    grid-column: 1 / -1;
    margin: -0.25rem 0 0;
  }

  #unit-no-results {
    color: var(--color-muted);
    margin-top: 0;
    margin-bottom: 0.8rem;
  }

  .unit {
    margin-bottom: 1.1rem;
    scroll-margin-top: 7.5rem;
  }

  .unit-title {
    color: var(--confession-accent-text, var(--color-heading));
    margin: 0 0 0.55rem;
  }

  .paragraph-list {
    display: grid;
    gap: 0.55rem;
  }

  .unit-back-to-top {
    margin: 0.55rem 0 0;
    text-align: right;
    font-size: 0.9rem;
  }

  .paragraph-share {
    position: absolute;
    top: 0.4rem;
    right: 0.4rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--color-muted);
    line-height: 1;
    cursor: pointer;
    opacity: 0.55;
  }

  .paragraph-card:hover .paragraph-share,
  .paragraph-share:focus-visible,
  .paragraph-card.is-sharing .paragraph-share {
    opacity: 1;
    border-color: var(--surface-border);
    background: var(--surface-bg-muted);
    color: var(--color-link);
