---
import Main from "../../../layouts/Main.astro";
import {
  findConfession,
  getConfessionAbout,
  getConfessionDisplayUnits,
  listConfessions,
} from "../../../lib/confessions";

export function getStaticPaths() {
  return listConfessions().map((item) => ({
    params: { slug: item.slug },
  }));
}

const { slug } = Astro.params;
const confession = findConfession(String(slug));

if (!confession) {
  return Astro.redirect("/");
}

const about = getConfessionAbout(confession);
const links = about.links ?? [];
const displayUnitCount = getConfessionDisplayUnits(confession).length;
---

<Main title={`About ${confession.title}`}>
  <section class="about-page" data-confession={confession.slug}>
    <header class="about-header">
      <h1>
        <span class="confession-badge">{confession.shortCode}</span>
        <span>About {confession.title}</span>
      </h1>
      <p class="meta">
        {displayUnitCount} {displayUnitCount === 1 ? confession.unitLabel.toLowerCase() : `${confession.unitLabel.toLowerCase()}s`}
        in this confession.
      </p>
    </header>

    <section class="card-panel about-card">
      <h2>{about.title}</h2>
      {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </section>

    {
      links.length > 0 && (
        <section class="about-links" aria-labelledby="about-links-heading">
          <h2 id="about-links-heading">Further reading</h2>
          <ul class="about-links-grid">
            {links.map((link) => (
              <li>
                <a class="about-link-card" href={link.url} target="_blank" rel="noopener noreferrer">
                  <span class="about-link-kind">{link.kind === "song" ? "Song" : "Reading"}</span>
                  <span class="about-link-label">{link.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p class="back-link">
      <a class="confession-link" href={`/confessions/${confession.slug}`}>Back to confession text</a>
    </p>
  </section>
</Main>

<style>
  .about-page {
    border: 1px solid var(--confession-accent-border, var(--surface-border));
    border-radius: 14px;
    padding: 0.8rem;
    background: color-mix(in srgb, var(--confession-accent-bg, transparent) 24%, transparent);
  }

  .about-header h1 {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    flex-wrap: wrap;
    margin-bottom: 0.35rem;
  }

  .about-header p {
    margin-top: 0;
  }

  .about-card {
    margin-top: 0.75rem;
    border-color: var(--confession-accent-border, var(--card-border));
    background:
      color-mix(in srgb, var(--confession-accent-bg, transparent) 18%, transparent),
      var(--card-bg);
  }

  .about-card p:last-child {
    margin-bottom: 0;
  }

  .about-links {
    margin-top: 0.75rem;
  }

  .about-links h2 {
    margin-bottom: 0.5rem;
  }

  .about-links-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
  }

  .about-link-card {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    height: 100%;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--confession-accent-border, var(--card-border));
    border-radius: 10px;
    background:
      color-mix(in srgb, var(--confession-accent-bg, transparent) 18%, transparent),
      var(--card-bg);
    text-decoration: none;
  }

  .about-link-card:hover,
  .about-link-card:focus-visible {
    border-color: var(--confession-accent-text, currentColor);
  }

  .about-link-kind {
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--confession-accent-text, inherit);
  }

  .about-link-label {
    font-size: 0.92rem;
    line-height: 1.3;
  }

  @media (max-width: 900px) {
    .about-links-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .about-links-grid {
      grid-template-columns: 1fr;
    }
  }

  .back-link {
    margin-top: 0.8rem;
  }
</style>
