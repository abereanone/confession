---
import Main from "../layouts/Main.astro";
import { listConfessions } from "../lib/confessions";
import { listBibleBooks } from "../lib/bible/bibleData";

const confessions = listConfessions();

// Just code/name/chapterCount for 66 books — enough for the resume card to
// derive the chapter after the one you stopped in, the same way the bookmarks
// page does.
const books = await listBibleBooks();
const bookCatalogJson = JSON.stringify(
  books.map((book) => ({ code: book.code, name: book.name, chapters: book.chapterCount }))
);
---

<Main title="Confessions Hub">
  <h1>Reformed Confessions & Bible Hub</h1>
  <p>Browse confessions, inspect every cited scripture, and read/search the full Bible text.</p>

  <section class="search-tools card-panel">
    <div class="tool-control">
      <label for="confession-search">Search all confessions</label>
      <input
        id="confession-search"
        type="search"
        placeholder="Search&mdash;Use quotes for exact phrase like &quot;the church&quot;"
        title="Use quotes for exact phrase like &quot;the church&quot;"
        autocomplete="off"
      />
    </div>
    <button type="button" id="confession-search-clear" hidden>Clear</button>
    <p id="confession-search-meta" class="meta"></p>
  </section>

  <section id="confession-search-results-section" hidden>
    <ul id="confession-search-results"></ul>
    <p id="confession-search-empty" hidden><em>No paragraphs matched that search.</em></p>
  </section>

  <section class="card-panel" id="confession-list-section">
    <h2>Confessions</h2>
    <ul class="confession-list">
      {confessions.map((item) => (
        <li data-confession={item.slug}>
          <a class="confession-link confession-item-link" href={`/confessions/${item.slug}`}>
            <span class="confession-badge">{item.shortCode}</span>
            <span>{item.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="card-panel section-spacer">
    <h2>Scripture Tools</h2>

    <div id="book-catalog-data" data-book-catalog={bookCatalogJson} hidden></div>
    <ul class="continue-list" data-continue-list hidden></ul>

    <ul class="tool-list">
      <li data-tool="references">
        <a class="tool-item-link" href="/scriptures">
          <span>Scripture References</span>
        </a>
      </li>
      <li data-tool="bible">
        <a class="tool-item-link" href="/bible">
          <span>Read the Bible</span>
        </a>
      </li>
    </ul>
  </section>
</Main>

<script>
  import { markHref, readPosition } from "../lib/bible/readingMarks";

  // The resume card, above the reader tile. Rendered client-side because the
  // position lives in localStorage and the page is static; the card stays hidden
  // until there is somewhere to go back to.
  (() => {
    const list = document.querySelector("[data-continue-list]");
    if (!(list instanceof HTMLElement)) {
      return;
    }

    const position = readPosition();
    if (!position) {
      return;
    }

    let books = [];
    try {
      books = JSON.parse(document.getElementById("book-catalog-data")?.dataset.bookCatalog || "[]");
    } catch {
      books = [];
    }

    /**
     * The chapter after this one, derived rather than stored so a place saved
     * before this existed still gets a link. Rolls over at the end of a book
     * (Genesis 50 -> Exodus 1) and at the end of the canon
     * (Revelation 22 -> Genesis 1). Mirrors the bookmarks page.
     */
    const nextChapterOf = (book, chapter) => {
      const index = books.findIndex((entry) => entry.code === book);
      if (index < 0) {
        return null;
      }

      const current = books[index];
      if (chapter < current.chapters) {
        return {
          book: current.code,
          chapter: chapter + 1,
          label: `${current.name} ${chapter + 1}`,
        };
      }

      const following = books[(index + 1) % books.length];
      return following ? { book: following.code, chapter: 1, label: `${following.name} 1` } : null;
    };

    const item = document.createElement("li");
    item.className = "continue-item";

    const link = document.createElement("a");
    link.className = "continue-item-link";
    link.href = markHref(position, "resume");

    const eyebrow = document.createElement("span");
    eyebrow.className = "continue-item-eyebrow";
    eyebrow.textContent = "Pick up where you left off";

    const reference = document.createElement("span");
    reference.className = "continue-item-ref";
    reference.textContent = position.label;

    link.append(eyebrow, reference);
    item.append(link);

    // Returning to where you stopped is one intent; carrying on into the next
    // chapter is the more common one, so both are offered in the card.
    const onwardTarget = nextChapterOf(position.book, position.chapter);
    if (onwardTarget) {
      const onward = document.createElement("a");
      onward.className = "continue-item-next";
      onward.href = `/bible/${encodeURIComponent(onwardTarget.book)}/${onwardTarget.chapter}`;

      const onwardLabel = document.createElement("span");
      onwardLabel.className = "continue-item-next-label";
      onwardLabel.textContent = "Next";

      const onwardRef = document.createElement("span");
      onwardRef.className = "continue-item-next-ref";
      onwardRef.textContent = onwardTarget.label;

      const go = document.createElement("span");
      go.setAttribute("aria-hidden", "true");
      go.textContent = "→";

      onward.append(onwardLabel, onwardRef, go);
      item.append(onward);
    }

    list.append(item);
    list.hidden = false;
  })();
</script>

<script>
  // Cross-confession paragraph search. Mirrors the per-confession filter's query
  // syntax (quoted phrases, all terms must match) but the text is not on the
  // page, so it comes from a prebuilt index fetched on first use — the same
  // approach the Bible reader takes with /bible-search.json.
  import { parseSearchTerms } from "../lib/searchTerms";

  (() => {
    const input = document.getElementById("confession-search");
    const clearButton = document.getElementById("confession-search-clear");
    const meta = document.getElementById("confession-search-meta");
    const section = document.getElementById("confession-search-results-section");
    const list = document.getElementById("confession-search-results");
    const empty = document.getElementById("confession-search-empty");
    const confessionList = document.getElementById("confession-list-section");

    if (!(input instanceof HTMLInputElement) || !(list instanceof HTMLElement)) {
      return;
    }

    const RESULT_LIMIT = 200;
    let indexPromise = null;
    let debounceTimer = 0;

    const escapeRegExp = (value) => String(value).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

    const getIndex = () => {
      if (!indexPromise) {
        indexPromise = fetch("/confessions-search.json")
          .then((response) => {
            if (!response.ok) {
              throw new Error(`index failed with ${response.status}`);
            }
            return response.json();
          })
          .then((payload) => (Array.isArray(payload?.paragraphs) ? payload.paragraphs : []));
      }
      return indexPromise;
    };

    const buildHighlightRegex = (terms) => {
      const pattern = terms
        .map((term) => {
          const escaped = escapeRegExp(term.value);
          // A quoted phrase may span a line break in the source text.
          return term.phrase ? escaped.replace(/\s+/g, "\\s+") : escaped;
        })
        .sort((a, b) => b.length - a.length)
        .join("|");
      return pattern ? new RegExp(pattern, "gi") : null;
    };

    const appendHighlighted = (target, text, regex) => {
      const source = String(text ?? "");
      if (!regex) {
        target.append(document.createTextNode(source));
        return;
      }

      regex.lastIndex = 0;
      let cursor = 0;
      for (const match of source.matchAll(regex)) {
        const index = match.index ?? 0;
        const hit = match[0] || "";
        if (!hit) {
          continue;
        }
        if (index > cursor) {
          target.append(document.createTextNode(source.slice(cursor, index)));
        }
        const mark = document.createElement("mark");
        mark.className = "search-hit";
        mark.textContent = hit;
        target.append(mark);
        cursor = index + hit.length;
      }
      if (cursor < source.length) {
        target.append(document.createTextNode(source.slice(cursor)));
      }
    };

    // Characters of context kept around the first match. Enough to read the
    // clause the term sits in without spilling past ~3 lines.
    const EXCERPT_BEFORE = 90;
    const EXCERPT_AFTER = 210;

    /**
     * A window of the paragraph centred on its first matching term.
     *
     * Showing the opening of the paragraph and clamping it hides the reason the
     * result is there at all — a paragraph matching on a word 40 lines down
     * looks like a false positive. Snaps to word boundaries so the excerpt never
     * starts or ends mid-word.
     */
    const buildExcerpt = (text, terms) => {
      const source = String(text ?? "");
      const haystack = source.toLowerCase();

      let matchStart = -1;
      let matchLength = 0;
      for (const term of terms) {
        const index = haystack.indexOf(term.value);
        if (index >= 0 && (matchStart < 0 || index < matchStart)) {
          matchStart = index;
          matchLength = term.value.length;
        }
      }

      // No term located (shouldn't happen for a result, but stay graceful).
      if (matchStart < 0) {
        const clipped = source.slice(0, EXCERPT_BEFORE + EXCERPT_AFTER);
        return { body: clipped, leading: false, trailing: clipped.length < source.length };
      }

      let start = Math.max(0, matchStart - EXCERPT_BEFORE);
      let end = Math.min(source.length, matchStart + matchLength + EXCERPT_AFTER);

      if (start > 0) {
        const space = source.indexOf(" ", start);
        if (space >= 0 && space < matchStart) {
          start = space + 1;
        }
      }
      if (end < source.length) {
        const space = source.lastIndexOf(" ", end);
        if (space > matchStart + matchLength) {
          end = space;
        }
      }

      return {
        body: source.slice(start, end).trim(),
        leading: start > 0,
        trailing: end < source.length,
      };
    };

    const showList = (visible) => {
      if (confessionList instanceof HTMLElement) {
        confessionList.hidden = !visible;
      }
    };

    const reset = () => {
      if (section instanceof HTMLElement) section.hidden = true;
      if (empty instanceof HTMLElement) empty.hidden = true;
      if (meta instanceof HTMLElement) meta.textContent = "";
      if (clearButton instanceof HTMLElement) clearButton.hidden = true;
      list.textContent = "";
      showList(true);
    };

    const render = (results, terms, total, ignored) => {
      const regex = buildHighlightRegex(terms);
      list.textContent = "";

      for (const result of results) {
        const item = document.createElement("li");

        const link = document.createElement("a");
        link.className = "result-card";
        link.href = result.href;

        const head = document.createElement("span");
        head.className = "result-head";

        const badge = document.createElement("span");
        badge.className = "confession-badge";
        badge.textContent = result.shortCode;

        const citation = document.createElement("span");
        citation.className = "result-citation";
        citation.textContent = result.unitTitle
          ? `${result.citation} — ${result.unitTitle}`
          : result.citation;

        head.append(badge, citation);

        const body = document.createElement("span");
        body.className = "result-text";
        const excerpt = buildExcerpt(result.text, terms);
        if (excerpt.leading) {
          body.append(document.createTextNode("… "));
        }
        appendHighlighted(body, excerpt.body, regex);
        if (excerpt.trailing) {
          body.append(document.createTextNode(" …"));
        }

        link.append(head, body);
        item.append(link);
        list.append(item);
      }

      if (section instanceof HTMLElement) section.hidden = false;
      if (empty instanceof HTMLElement) empty.hidden = results.length > 0;
      if (meta instanceof HTMLElement) {
        const shown = results.length;
        const count =
          total > shown
            ? `Showing first ${shown} of ${total} matching paragraphs`
            : `${shown} matching paragraph${shown === 1 ? "" : "s"}`;
        // Say so rather than silently changing the query out from under them.
        const skipped = ignored.length
          ? ` · ignored ${ignored.map((word) => `"${word}"`).join(", ")} — quote to match exactly`
          : "";
        meta.textContent = `${count}${skipped}`;
      }
      showList(false);
    };

    const run = async () => {
      const raw = input.value.trim();
      if (clearButton instanceof HTMLElement) {
        clearButton.hidden = raw.length === 0;
      }

      if (!raw) {
        reset();
        return;
      }

      const { terms, ignored } = parseSearchTerms(raw);
      if (terms.length === 0) {
        reset();
        return;
      }

      if (meta instanceof HTMLElement && !indexPromise) {
        meta.textContent = "Searching…";
      }

      try {
        const paragraphs = await getIndex();
        // Every term must appear, matching the per-confession filter.
        const matches = paragraphs.filter((entry) => {
          const haystack = String(entry.text ?? "").toLowerCase();
          return terms.every((term) => haystack.includes(term.value));
        });
        render(matches.slice(0, RESULT_LIMIT), terms, matches.length, ignored);
      } catch {
        if (section instanceof HTMLElement) section.hidden = false;
        if (meta instanceof HTMLElement) {
          meta.textContent = "Search is unavailable right now.";
        }
        list.textContent = "";
        if (empty instanceof HTMLElement) empty.hidden = true;
      }
    };

    input.addEventListener("input", () => {
      window.clearTimeout(debounceTimer);
      debounceTimer = window.setTimeout(run, 180);
    });

    input.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        input.value = "";
        reset();
      }
    });

    if (clearButton instanceof HTMLButtonElement) {
      clearButton.addEventListener("click", () => {
        input.value = "";
        reset();
        input.focus();
      });
    }
  })();
</script>

<style>
  .section-spacer {
    margin-top: 1rem;
  }

  .search-tools {
    display: flex;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    margin-bottom: 1rem;
  }

  .tool-control {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1 1 22rem;
    min-width: 0;
  }

  .tool-control label {
    font-weight: 600;
  }

  .search-tools button {
    min-height: 2.2rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--surface-border);
    border-radius: 999px;
    background: var(--surface-bg-muted);
    color: var(--color-text);
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
  }

  .search-tools button:hover,
  .search-tools button:focus-visible {
    border-color: var(--color-link);
    background: var(--surface-bg-hover);
    outline: none;
  }

  .search-tools button[hidden] {
    display: none;
  }

  .search-tools .meta {
    margin: 0;
  }

  #confession-search-results-section[hidden],
  #confession-list-section[hidden] {
    display: none;
  }

  #confession-search-results {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  #confession-search-results li {
    list-style: none;
  }

  /* Result cards are built in JavaScript, so they never carry Astro's scoping
     attribute; scope through the server-rendered list instead. */
  #confession-search-results :global(.result-card) {
    display: grid;
    gap: 0.35rem;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--card-border);
    border-left: 4px solid var(--confession-accent-border, var(--surface-border-strong));
    border-radius: 10px;
    background: var(--card-bg);
    color: var(--color-text);
    text-decoration: none;
  }

  #confession-search-results :global(.result-card:hover),
  #confession-search-results :global(.result-card:focus-visible) {
    border-color: var(--confession-accent-border, var(--card-hover-border));
    text-decoration: none;
  }

  #confession-search-results :global(.result-head) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  #confession-search-results :global(.result-citation) {
    font-weight: 700;
  }

  /* The excerpt is already bounded by character count and centred on the match;
     the clamp is only a safety net for very long unbroken text. */
  #confession-search-results :global(.result-text) {
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.45;
  }

  /* There is no global rule for this class, so without it the marks would fall
     back to the browser's default yellow and ignore the theme. */
  #confession-search-results :global(mark.search-hit) {
    border-radius: 0.18em;
    padding: 0 0.08em;
    background: rgba(255, 232, 107, 0.82);
    color: #1f1a00;
  }

  .confession-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .confession-list li,
  .tool-list li {
    list-style: none;
  }

  .confession-item-link,
  .tool-item-link {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    border: 1px solid var(--surface-border);
    border-left-width: 4px;
    border-left-color: var(--confession-accent-border, var(--surface-border-strong));
    border-radius: 10px;
    background: var(--surface-bg-muted);
    padding: 0.45rem 0.55rem;
    text-decoration: none;
  }

  .confession-item-link:hover,
  .confession-item-link:focus-visible,
  .tool-item-link:hover,
  .tool-item-link:focus-visible {
    border-color: var(--confession-accent-border, var(--card-hover-border));
    text-decoration: none;
  }

  .tool-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .tool-item-link {
    border-left-color: var(--tool-accent-border);
    color: var(--tool-accent-text);
    font-weight: 600;
  }

  /* Resume card. Built in JavaScript, so the row carries no scoping attribute —
     scope through the server-rendered list, as the bookmarks page does. */
  .continue-list {
    list-style: none;
    margin: 0 0 0.75rem;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .continue-list[hidden] {
    display: none;
  }

  .continue-list :global(.continue-item) {
    display: flex;
    align-items: stretch;
    border: 1px solid var(--surface-border);
    border-left: 4px solid var(--color-link);
    border-radius: 10px;
    background: var(--surface-bg-muted);
    overflow: hidden;
  }

  .continue-list :global(.continue-item:hover),
  .continue-list :global(.continue-item:focus-within) {
    border-color: var(--color-link);
  }

  .continue-list :global(.continue-item-link) {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.1rem;
    flex: 1 1 auto;
    min-width: 0;
    padding: 0.55rem 0.85rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .continue-list :global(.continue-item-link:hover),
  .continue-list :global(.continue-item-link:focus-visible) {
    background: var(--surface-bg-hover);
    text-decoration: none;
  }

  .continue-list :global(.continue-item-eyebrow),
  .continue-list :global(.continue-item-next-label) {
    color: var(--color-muted);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .continue-list :global(.continue-item-ref) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 700;
  }

  /* Fixed basis rather than content width, matching the bookmarks rows: book
     names differ in length and a content-sized column moves the divider. */
  .continue-list :global(.continue-item-next) {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex: 0 0 13.5rem;
    min-width: 0;
    padding: 0.55rem 0.85rem;
    border-left: 1px solid var(--surface-border);
    color: var(--color-link);
    text-decoration: none;
    white-space: nowrap;
  }

  .continue-list :global(.continue-item-next:hover),
  .continue-list :global(.continue-item-next:focus-visible) {
    background: var(--surface-bg-hover);
    text-decoration: none;
  }

  /* Takes the slack so the arrow sits flush right, and truncates rather than
     widening the column for a long name like 1 Thessalonians 2. */
  .continue-list :global(.continue-item-next-ref) {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    font-weight: 700;
  }

  @media (max-width: 32rem) {
    .continue-list :global(.continue-item-next-label) {
      display: none;
    }

    .continue-list :global(.continue-item-next) {
      flex-basis: 9rem;
      padding: 0.55rem 0.6rem;
    }
  }

  .tool-item-link:hover,
  .tool-item-link:focus-visible {
    border-color: var(--tool-accent-border);
    color: var(--tool-accent-text);
  }

  [data-tool="references"] {
    --tool-accent-border: rgba(168, 174, 181, 0.56);
    --tool-accent-bg: rgba(168, 174, 181, 0.16);
    --tool-accent-text: #d9dee4;
  }

  [data-tool="bible"] {
    --tool-accent-border: rgba(78, 88, 98, 0.68);
    --tool-accent-bg: rgba(78, 88, 98, 0.28);
    --tool-accent-text: #eef1f4;
  }

  :global([data-theme="light"]) [data-tool="references"] {
    --tool-accent-border: rgba(104, 113, 122, 0.58);
    --tool-accent-bg: rgba(188, 194, 201, 0.5);
    --tool-accent-text: #1f2429;
  }

  :global([data-theme="light"]) [data-tool="bible"] {
    --tool-accent-border: rgba(50, 57, 64, 0.64);
    --tool-accent-bg: rgba(86, 96, 106, 0.28);
    --tool-accent-text: #11161a;
  }

  :global([data-theme="light"]) .tool-item-link,
  :global([data-theme="light"]) .tool-item-link:hover,
  :global([data-theme="light"]) .tool-item-link:focus-visible {
    color: var(--tool-accent-text);
  }

  @media (max-width: 720px) {
    .confession-list,
    .tool-list {
      grid-template-columns: 1fr;
    }
  }
</style>
