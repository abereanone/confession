---
import Main from "../../layouts/Main.astro";
import { listBibleBooks } from "../../lib/bible/bibleData";

// Just code/name/chapterCount for 66 books — enough to derive the next chapter
// for any row, including ones saved before this feature existed.
const books = await listBibleBooks();
const bookCatalogJson = JSON.stringify(
  books.map((book) => ({ code: book.code, name: book.name, chapters: book.chapterCount }))
);
---

<Main title="Bookmarks">
  {/* The visible headings now label their own sections, but the page still
      needs one top-level heading for assistive tech and search results. */}
  <h1 class="sr-only">Bookmarks</h1>

  <section class="card-panel continue-panel" data-continue hidden>
    <h2>Continue where you left off</h2>
    <ul class="continue-list" data-continue-list></ul>
  </section>

  <div id="book-catalog-data" data-book-catalog={bookCatalogJson} hidden></div>

  <section class="card-panel section-spacer">
    <h2 class="marks-heading">Bookmarks</h2>
    <ul class="mark-list" data-mark-list hidden></ul>
    <p class="meta" data-mark-empty>
      No bookmarks yet — use the ribbon beside a chapter heading in the reader.
    </p>
  </section>
</Main>

<script>
  import {
    listBookmarks,
    listRecentChapters,
    markHref,
    removeBookmarkById,
  } from "../../lib/bible/readingMarks";

  (() => {
    const continuePanel = document.querySelector("[data-continue]");
    const continueList = document.querySelector("[data-continue-list]");
    const markList = document.querySelector("[data-mark-list]");
    const markEmpty = document.querySelector("[data-mark-empty]");

    let books = [];
    try {
      books = JSON.parse(document.getElementById("book-catalog-data")?.dataset.bookCatalog || "[]");
    } catch {
      books = [];
    }

    /**
     * The chapter after this one, derived rather than stored so every row gets a
     * link — including rows saved before this existed. Rolls over at the end of
     * a book (Genesis 50 -> Exodus 1) and at the end of the canon
     * (Revelation 22 -> Genesis 1).
     */
    const nextChapterOf = (book, chapter) => {
      const index = books.findIndex((entry) => entry.code === book);
      if (index < 0) {
        return null;
      }

      const current = books[index];
      if (chapter < current.chapters) {
        return {
          book: current.code,
          chapter: chapter + 1,
          label: `${current.name} ${chapter + 1}`,
        };
      }

      const following = books[(index + 1) % books.length];
      return following ? { book: following.code, chapter: 1, label: `${following.name} 1` } : null;
    };

    const formatSavedAt = (value) => {
      if (!value) {
        return "";
      }
      try {
        return new Date(value).toLocaleDateString(undefined, {
          month: "short",
          day: "numeric",
          year: "numeric",
        });
      } catch {
        return "";
      }
    };

    const renderResume = () => {
      if (!(continueList instanceof HTMLElement)) {
        return;
      }

      const recents = listRecentChapters();
      continueList.textContent = "";

      for (const recent of recents) {
        const item = document.createElement("li");
        item.className = "continue-item";

        const link = document.createElement("a");
        link.className = "continue-item-link";
        link.href = markHref(recent, "resume");
        link.textContent = recent.label;
        item.append(link);

        // Returning to where you stopped is one intent; carrying on into the
        // next chapter is the more common one, so both are offered in the row.
        const onwardTarget = nextChapterOf(recent.book, recent.chapter);
        if (onwardTarget) {
          const onward = document.createElement("a");
          onward.className = "continue-item-next";
          onward.href = `/bible/${encodeURIComponent(onwardTarget.book)}/${onwardTarget.chapter}`;

          const eyebrow = document.createElement("span");
          eyebrow.className = "continue-item-next-label";
          eyebrow.textContent = "Next";

          const name = document.createElement("span");
          name.className = "continue-item-next-ref";
          name.textContent = onwardTarget.label;

          const go = document.createElement("span");
          go.setAttribute("aria-hidden", "true");
          go.textContent = "→";

          onward.append(eyebrow, name, go);
          item.append(onward);
        }

        continueList.append(item);
      }

      if (continuePanel instanceof HTMLElement) {
        continuePanel.hidden = recents.length === 0;
      }
    };

    const renderBookmarks = () => {
      if (!(markList instanceof HTMLElement)) {
        return;
      }

      const bookmarks = listBookmarks();
      markList.textContent = "";

      for (const bookmark of bookmarks) {
        const item = document.createElement("li");
        item.className = "mark-item";

        const link = document.createElement("a");
        link.className = "mark-item-link";
        link.href = markHref(bookmark, "bookmark");

        const label = document.createElement("span");
        label.className = "mark-item-ref";
        label.textContent = bookmark.label;

        const saved = document.createElement("span");
        saved.className = "mark-item-date";
        saved.textContent = formatSavedAt(bookmark.at);

        link.append(label, saved);

        const remove = document.createElement("button");
        remove.type = "button";
        remove.className = "mark-item-remove";
        remove.dataset.markRemove = bookmark.id;
        remove.setAttribute("aria-label", `Remove bookmark ${bookmark.label}`);
        remove.title = `Remove bookmark ${bookmark.label}`;
        remove.textContent = "✕";

        item.append(link, remove);
        markList.append(item);
      }

      markList.hidden = bookmarks.length === 0;
      if (markEmpty instanceof HTMLElement) {
        markEmpty.hidden = bookmarks.length > 0;
      }
    };

    if (markList instanceof HTMLElement) {
      markList.addEventListener("click", (event) => {
        const trigger = event.target instanceof Element ? event.target.closest("[data-mark-remove]") : null;
        if (!(trigger instanceof HTMLElement)) {
          return;
        }
        removeBookmarkById(String(trigger.dataset.markRemove || ""));
        renderBookmarks();
      });
    }

    renderResume();
    renderBookmarks();
  })();
</script>

<style>
  .section-spacer {
    margin-top: 1rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .continue-panel[hidden] {
    display: none;
  }

  .continue-panel h2,
  .marks-heading {
    margin-top: 0;
  }

  .continue-list {
    list-style: none;
    margin: 0.85rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  /* Built in JavaScript, so the rows carry no scoping attribute — see the
     bookmark list below. */
  .continue-list :global(.continue-item) {
    display: flex;
    align-items: stretch;
    border: 1px solid var(--surface-border);
    border-left: 4px solid var(--color-link);
    border-radius: 10px;
    background: var(--surface-bg-muted);
    overflow: hidden;
  }

  .continue-list :global(.continue-item:hover),
  .continue-list :global(.continue-item:focus-within) {
    border-color: var(--color-link);
  }

  .continue-list :global(.continue-item-link) {
    display: flex;
    align-items: center;
    flex: 1 1 auto;
    min-width: 0;
    padding: 0.65rem 0.85rem;
    color: var(--color-text);
    font-weight: 700;
    text-decoration: none;
  }

  .continue-list :global(.continue-item-link:hover),
  .continue-list :global(.continue-item-link:focus-visible) {
    background: var(--surface-bg-hover);
    text-decoration: none;
  }

  /* Fixed basis rather than content width: book names differ in length, so a
     content-sized column put the divider in a different place on every row and
     the rule zig-zagged down the list. */
  .continue-list :global(.continue-item-next) {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex: 0 0 13.5rem;
    min-width: 0;
    padding: 0.65rem 0.85rem;
    border-left: 1px solid var(--surface-border);
    color: var(--color-link);
    text-decoration: none;
    white-space: nowrap;
  }

  .continue-list :global(.continue-item-next:hover),
  .continue-list :global(.continue-item-next:focus-visible) {
    background: var(--surface-bg-hover);
    text-decoration: none;
  }

  .continue-list :global(.continue-item-next-label) {
    color: var(--color-muted);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Takes the slack so the arrow sits flush right in every row, and truncates
     rather than widening the column for a long name like 1 Thessalonians 2. */
  .continue-list :global(.continue-item-next-ref) {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    font-weight: 700;
  }

  @media (max-width: 32rem) {
    .continue-list :global(.continue-item-next-label) {
      display: none;
    }

    /* Narrower, but still a fixed basis so the rows stay aligned. */
    .continue-list :global(.continue-item-next) {
      flex-basis: 9rem;
      padding: 0.65rem 0.6rem;
    }
  }

  .mark-list {
    list-style: none;
    margin: 0.85rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .mark-list[hidden] {
    display: none;
  }

  /* The rows are built in JavaScript, so they never carry Astro's scoping
     attribute and plain `.mark-item` rules would not match them. Scope through
     the server-rendered list instead: the parent stays scoped, the descendants
     are global. (Same reason the reader marks its search results `:global`.) */
  .mark-list :global(.mark-item) {
    display: flex;
    align-items: stretch;
    border: 1px solid var(--surface-border);
    border-radius: 10px;
    background: var(--surface-bg-muted);
    overflow: hidden;
  }

  .mark-list :global(.mark-item:hover),
  .mark-list :global(.mark-item:focus-within) {
    border-color: var(--color-link);
  }

  .mark-list :global(.mark-item-link) {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
    flex: 1 1 auto;
    padding: 0.6rem 0.85rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .mark-list :global(.mark-item-link:hover),
  .mark-list :global(.mark-item-link:focus-visible) {
    background: var(--surface-bg-hover);
    text-decoration: none;
  }

  .mark-list :global(.mark-item-ref) {
    font-weight: 700;
  }

  .mark-list :global(.mark-item-date) {
    margin-left: auto;
    color: var(--color-muted);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .mark-list :global(.mark-item-remove) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.6rem;
    padding: 0.5rem;
    border: 0;
    border-left: 1px solid var(--surface-border);
    background: transparent;
    color: var(--color-muted);
    font-size: 0.85rem;
    line-height: 1;
    cursor: pointer;
  }

  .mark-list :global(.mark-item-remove:hover),
  .mark-list :global(.mark-item-remove:focus-visible) {
    background: var(--surface-bg-hover);
    color: var(--color-text);
    outline: none;
  }
</style>
