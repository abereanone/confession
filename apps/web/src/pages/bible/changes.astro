---
import Main from "../../layouts/Main.astro";
import { getBsbChangeSummary, listBsbChanges } from "../../lib/bible/bsbChanges";

const changes = await listBsbChanges();
const summary = await getBsbChangeSummary();
const pluralizedChangeCount = `${summary.total.toLocaleString()} change${summary.total === 1 ? "" : "s"}`;
---

<Main title="BSB Change Log">
  <header class="changes-header">
    <p class="eyebrow">Bible Reader</p>
    <h1>BSB Change Log</h1>
    <p class="meta">
      {pluralizedChangeCount} generated from the local BSB transformation pipeline.
    </p>
  </header>

  <section class="change-summary" aria-label="Change summary">
    <button type="button" class="summary-stat is-active" data-summary-filter data-type="">
      <span class="summary-value">{summary.total.toLocaleString()}</span>
      <span class="summary-label">Total Changes</span>
    </button>
    {summary.byType.map((item) => (
      <button type="button" class="summary-stat" data-summary-filter data-type={item.type}>
        <span class="summary-value">{item.count.toLocaleString()}</span>
        <span class="summary-label">{item.label}</span>
      </button>
    ))}
  </section>

  <section class="change-tools card-panel" aria-label="Change filters">
    <div class="filter-grid">
      <label>
        Search
        <input
          type="search"
          placeholder="Reference, phrase, type, or reason"
          data-change-search
        />
      </label>

      <label>
        Type
        <select data-change-type>
          <option value="">All types</option>
          {summary.byType.map((item) => (
            <option value={item.type}>{item.label}</option>
          ))}
        </select>
      </label>

      <label>
        Book
        <select data-change-book>
          <option value="">All books</option>
          {summary.byBook.map((book) => (
            <option value={book.code}>{book.name}</option>
          ))}
        </select>
      </label>
    </div>
    <p class="meta result-count" data-change-count>
      Showing {changes.length.toLocaleString()} changes
    </p>
  </section>

  <section class="change-list" aria-label="BSB changes">
    {changes.map((change) => (
      <article
        class="change-item"
        id={change.id}
        data-change-item
        data-book={change.bookCode}
        data-type={change.type}
      >
        <header class="change-item-header">
          <div>
            <h2>{change.reference}</h2>
            <p class="meta">
              <span class="change-type">{change.typeLabel}</span>
              {change.typeDescription ? <span>{change.typeDescription}</span> : null}
              {change.version ? <span>Version: {change.version}</span> : null}
              {change.reason ? <span>{change.reason}</span> : null}
            </p>
          </div>
          <a href={`/bible/${change.bookCode}/${change.chapter}#verse-${change.verse}`}>
            Open Verse
          </a>
        </header>

        <div class="change-comparison">
          <div class="change-text-block">
            <h3>Before</h3>
            <p set:html={change.beforeHtml} />
          </div>
          <div class="change-text-block">
            <h3>After</h3>
            <p set:html={change.afterHtml} />
          </div>
        </div>
      </article>
    ))}
  </section>

  <p class="empty-state" data-empty-state hidden>
    No changes match those filters.
  </p>

  <script>
    (() => {
      const searchInput = document.querySelector("[data-change-search]");
      const typeSelect = document.querySelector("[data-change-type]");
      const bookSelect = document.querySelector("[data-change-book]");
      const countNode = document.querySelector("[data-change-count]");
      const emptyState = document.querySelector("[data-empty-state]");
      const summaryFilters = Array.from(document.querySelectorAll("[data-summary-filter]"));
      const items = Array.from(document.querySelectorAll("[data-change-item]"));

      const normalize = (value) => String(value || "").trim().toLowerCase();

      const syncSummaryFilters = (selectedType) => {
        for (const filter of summaryFilters) {
          if (!(filter instanceof HTMLElement)) {
            continue;
          }
          filter.classList.toggle("is-active", normalize(filter.dataset.type) === selectedType);
          if (filter instanceof HTMLButtonElement) {
            filter.setAttribute("aria-pressed", normalize(filter.dataset.type) === selectedType ? "true" : "false");
          }
        }
      };

      const updateFilters = () => {
        const query = normalize(searchInput instanceof HTMLInputElement ? searchInput.value : "");
        const selectedType = normalize(typeSelect instanceof HTMLSelectElement ? typeSelect.value : "");
        const selectedBook = normalize(bookSelect instanceof HTMLSelectElement ? bookSelect.value : "");
        let visibleCount = 0;

        for (const item of items) {
          if (!(item instanceof HTMLElement)) {
            continue;
          }

          const matchesQuery = !query || normalize(item.textContent).includes(query);
          const matchesType = !selectedType || normalize(item.dataset.type) === selectedType;
          const matchesBook = !selectedBook || normalize(item.dataset.book) === selectedBook;
          const isVisible = matchesQuery && matchesType && matchesBook;

          item.hidden = !isVisible;
          if (isVisible) {
            visibleCount += 1;
          }
        }

        if (countNode) {
          countNode.textContent = `Showing ${visibleCount.toLocaleString()} change${visibleCount === 1 ? "" : "s"}`;
        }
        if (emptyState instanceof HTMLElement) {
          emptyState.hidden = visibleCount !== 0;
        }
        syncSummaryFilters(selectedType);
      };

      for (const filter of summaryFilters) {
        if (!(filter instanceof HTMLButtonElement)) {
          continue;
        }
        filter.addEventListener("click", () => {
          if (typeSelect instanceof HTMLSelectElement) {
            typeSelect.value = String(filter.dataset.type || "");
          }
          updateFilters();
        });
      }

      searchInput?.addEventListener("input", updateFilters);
      typeSelect?.addEventListener("change", updateFilters);
      bookSelect?.addEventListener("change", updateFilters);
      updateFilters();
    })();
  </script>
</Main>

<style>
  .changes-header {
    margin-bottom: 1rem;
  }

  .eyebrow {
    margin: 0 0 0.2rem;
    color: var(--color-muted);
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .changes-header h1 {
    margin-top: 0;
  }

  .change-summary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0.7rem;
    margin: 1rem 0;
  }

  .summary-stat {
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.85rem 1rem;
    border: 1px solid var(--surface-border);
    border-radius: 8px;
    background: var(--surface-bg-muted);
    color: var(--color-text);
    cursor: pointer;
  }

  .summary-stat:hover,
  .summary-stat:focus-visible {
    border-color: var(--color-link);
    background: var(--surface-bg-hover);
    outline: none;
  }

  .summary-stat.is-active {
    border-color: var(--color-link);
    background: color-mix(in srgb, var(--color-link) 14%, var(--surface-bg));
  }

  .summary-value,
  .summary-label {
    display: block;
  }

  .summary-value {
    color: var(--color-heading);
    font-size: 1.55rem;
    font-weight: 700;
    line-height: 1.1;
  }

  .summary-label {
    color: var(--color-muted);
    font-size: 0.92rem;
    font-weight: 600;
  }

  .change-tools {
    margin: 1rem 0;
    border-radius: 8px;
  }

  .filter-grid {
    display: grid;
    grid-template-columns: minmax(16rem, 1fr) minmax(10rem, 14rem) minmax(10rem, 16rem);
    gap: 0.75rem;
    align-items: end;
  }

  .filter-grid label {
    display: grid;
    gap: 0.25rem;
    font-weight: 700;
  }

  .filter-grid input,
  .filter-grid select {
    width: 100%;
    box-sizing: border-box;
  }

  .result-count {
    margin: 0.7rem 0 0;
  }

  .change-list {
    display: grid;
    gap: 0.75rem;
  }

  .change-item {
    padding: 0.9rem 1rem;
    border: 1px solid var(--surface-border);
    border-radius: 8px;
    background: var(--card-bg);
  }

  .change-item-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .change-item h2,
  .change-item h3,
  .change-item p {
    margin-top: 0;
  }

  .change-item h2 {
    margin-bottom: 0.2rem;
    font-size: 1.45rem;
  }

  .change-item-header a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--surface-border);
    border-radius: 999px;
    background: var(--surface-bg-muted);
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
  }

  .change-item-header a:hover,
  .change-item-header a:focus-visible {
    border-color: var(--color-link);
    background: var(--surface-bg-hover);
  }

  .change-type {
    color: var(--color-heading);
    font-weight: 700;
  }

  .change-item .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.65rem;
    margin-bottom: 0;
  }

  .change-comparison {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .change-text-block {
    padding: 0.75rem;
    border: 1px solid var(--surface-border);
    border-radius: 8px;
    background: var(--surface-bg-muted);
  }

  .change-text-block h3 {
    margin-bottom: 0.35rem;
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .change-text-block p {
    margin-bottom: 0;
    line-height: 1.5;
  }

  .change-text-block :global(.change-highlight) {
    padding: 0 0.12em;
    border-radius: 4px;
    background: rgba(255, 232, 107, 0.78);
    color: #1f2d22;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .empty-state {
    padding: 1rem;
    text-align: center;
  }

  @media (max-width: 760px) {
    .filter-grid,
    .change-comparison {
      grid-template-columns: 1fr;
    }

    .change-item-header a {
      width: 100%;
    }
  }
</style>
