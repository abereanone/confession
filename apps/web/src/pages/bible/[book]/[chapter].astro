---
import Main from "../../../layouts/Main.astro";
import {
  getBibleProviderName,
  getBibleChapter,
  listBibleBooks,
  resolveBibleReference,
} from "../../../lib/bible/bibleData";
import { listScriptures } from "../../../lib/scriptures";
import { buildChapterVerseScriptureMap } from "../../../lib/scriptureRanges";
import { listBsbChanges } from "../../../lib/bible/bsbChanges";
import { getChapterAudioUrl, CHAPTER_AUDIO_READER } from "../../../lib/bible/audio";

export async function getStaticPaths() {
  const books = await listBibleBooks();
  return books.flatMap((book) =>
    Array.from({ length: book.chapterCount }, (_value, index) => ({
      params: {
        book: book.code,
        chapter: String(index + 1),
      },
    }))
  );
}

const query = String(Astro.url.searchParams.get("q") ?? "").trim();
const refQuery = String(Astro.url.searchParams.get("ref") ?? "").trim();
const rawScope = String(Astro.url.searchParams.get("scope") ?? "").trim().toLowerCase();
const selectedScope = rawScope === "ot" || rawScope === "nt" ? rawScope : "all";
const requestedBook = String(Astro.params.book ?? "").trim().toLowerCase();
const requestedChapter = Number.parseInt(String(Astro.params.chapter ?? ""), 10);

let provider = "BSB";
let books: Awaited<ReturnType<typeof listBibleBooks>> = [];
let selectedBookCode = "";
let selectedBookName = "";
let selectedChapter = 1;
let chapterCount = 1;
let chapterVerses: Awaited<ReturnType<typeof getBibleChapter>> = [];
let targetVerse = 0;
let selectedBookIndex = -1;

provider = await getBibleProviderName();
books = await listBibleBooks();

if (books.length > 0) {
  const fallbackBook = books[0]?.code ?? "";
  const candidateBook =
    books.some((book) => book.code === requestedBook) ? requestedBook : fallbackBook;
  const selectedBook = books.find((book) => book.code === candidateBook) ?? books[0];
  selectedBookIndex = books.findIndex((book) => book.code === selectedBook?.code);

  selectedBookCode = selectedBook?.code ?? fallbackBook;
  selectedBookName = selectedBook?.name ?? "";
  chapterCount = selectedBook?.chapterCount ?? 1;

  const candidateChapter = Number.isFinite(requestedChapter) ? requestedChapter : 1;
  selectedChapter = Math.min(Math.max(candidateChapter, 1), Math.max(chapterCount, 1));

  chapterVerses = await getBibleChapter(selectedBookCode, selectedChapter);

  if (refQuery) {
    const resolvedRef = await resolveBibleReference(refQuery);
    if (
      resolvedRef &&
      resolvedRef.bookCode === selectedBookCode &&
      resolvedRef.chapter === selectedChapter &&
      resolvedRef.verse
    ) {
      targetVerse = resolvedRef.verse;
    }
  }
}

let previousTarget: { bookCode: string; chapter: number } | null = null;
let nextTarget: { bookCode: string; chapter: number } | null = null;

if (selectedBookCode && books.length > 0 && selectedBookIndex >= 0) {
  if (selectedChapter > 1) {
    previousTarget = { bookCode: selectedBookCode, chapter: selectedChapter - 1 };
  } else if (selectedBookIndex > 0) {
    const previousBook = books[selectedBookIndex - 1];
    if (previousBook) {
      previousTarget = { bookCode: previousBook.code, chapter: previousBook.chapterCount };
    }
  }

  if (selectedChapter < chapterCount) {
    nextTarget = { bookCode: selectedBookCode, chapter: selectedChapter + 1 };
  } else if (selectedBookIndex < books.length - 1) {
    const nextBook = books[selectedBookIndex + 1];
    if (nextBook) {
      nextTarget = { bookCode: nextBook.code, chapter: 1 };
    }
  }
}

const scopeSuffix = selectedScope === "all" ? "" : `?scope=${selectedScope}`;
const previousChapterHref = previousTarget
  ? `/bible/${previousTarget.bookCode}/${previousTarget.chapter}${scopeSuffix}`
  : "";
const nextChapterHref = nextTarget
  ? `/bible/${nextTarget.bookCode}/${nextTarget.chapter}${scopeSuffix}`
  : "";
const chapterFootnotesByVerse = new Map<number, { href: string; referenceCount: number }>();
const chapterChangesByVerse = new Map<
  number,
  Awaited<ReturnType<typeof listBsbChanges>>
>();
let chapterFootnoteCount = 0;

if (selectedBookCode && selectedChapter > 0 && chapterVerses.length > 0) {
  const chapterMaxVerse = chapterVerses[chapterVerses.length - 1]?.verse ?? chapterVerses.length;
  const scriptureEntries = listScriptures();
  const verseMatches = buildChapterVerseScriptureMap(
    scriptureEntries,
    selectedBookCode,
    selectedChapter,
    chapterMaxVerse
  );

  verseMatches.forEach((entries, verseNumber) => {
    chapterFootnotesByVerse.set(verseNumber, {
      href: `/scriptures/verse/${selectedBookCode}/${selectedChapter}#verse-${verseNumber}`,
      referenceCount: entries.length,
    });
  });
  chapterFootnoteCount = chapterFootnotesByVerse.size;

  const allChanges = await listBsbChanges();
  allChanges
    .filter((change) => change.bookCode === selectedBookCode && change.chapter === selectedChapter)
    .forEach((change) => {
      const existing = chapterChangesByVerse.get(change.verse) ?? [];
      existing.push(change);
      chapterChangesByVerse.set(change.verse, existing);
    });
}

const bookCatalogJson = JSON.stringify(books);
// Previous/Next already resolve across book boundaries, so handing these to the
// recents list is what lets a run of chapters collapse to the last one reached.
const adjacentChaptersJson = JSON.stringify(
  [previousTarget, nextTarget]
    .filter((target): target is { bookCode: string; chapter: number } => target !== null)
    .map((target) => ({ book: target.bookCode, chapter: target.chapter }))
);
const chapterAudioUrl =
  selectedBookCode && selectedChapter > 0
    ? getChapterAudioUrl(selectedBookCode, selectedChapter)
    : null;
---

<Main title="Bible Reader">
  <h1>{provider}</h1>

  <a class="resume-bar" data-resume-bar href="/bible" hidden>
    <span class="resume-bar-text">
      <span class="resume-bar-label">Continue where you left off</span>
      <span class="resume-bar-ref" data-resume-bar-ref></span>
    </span>
    <span class="resume-bar-go" aria-hidden="true">→</span>
  </a>

  <p class="resume-note" data-resume-note hidden role="status">
    <span class="resume-bar-label">Your place is saved</span>
    <span class="resume-bar-ref" data-resume-note-ref></span>
  </p>

  <section class="reader-tools card-panel">
    <div class="controls">
      <div class="scope-pills" role="group" aria-label="Book scope">
        <button
          type="button"
          class:list={["scope-pill", selectedScope === "all" && "is-active"]}
          data-scope-pill
          data-scope="all"
        >
          ALL
        </button>
        <button
          type="button"
          class:list={["scope-pill", selectedScope === "ot" && "is-active"]}
          data-scope-pill
          data-scope="ot"
        >
          OT
        </button>
        <button
          type="button"
          class:list={["scope-pill", selectedScope === "nt" && "is-active"]}
          data-scope-pill
          data-scope="nt"
        >
          NT
        </button>
      </div>

      <form method="get" action="/bible" class="control-group" data-chapter-form>
        <select id="book" name="book" aria-label="Book" data-book-select>
          {books.map((book) => (
            <option value={book.code} selected={book.code === selectedBookCode}>
              {book.name}
            </option>
          ))}
        </select>
        <select
          id="chapter"
          name="chapter"
          aria-label="Chapter"
          data-chapter-select
        >
          {Array.from({ length: chapterCount }, (_value, index) => {
            const chapterNumber = index + 1;
            return (
              <option value={chapterNumber} selected={chapterNumber === selectedChapter}>
                {chapterNumber}
              </option>
            );
          })}
        </select>
      </form>

      <form method="get" action="/bible" class="control-group control-group-query" data-lookup-form>
        <label for="lookup">Jump or search</label>
        <input
          id="lookup"
          type="search"
          name="lookup"
          placeholder="e.g. John 3:16 or in the beginning"
          value={refQuery || query}
          data-lookup-input
        />
        <input type="hidden" name="scope" value={selectedScope} data-scope-input />
        <button type="submit" data-lookup-submit>Go</button>
      </form>
    </div>
  </section>

    <section class="card-panel section-spacer" data-search-section hidden>
      <div class="search-results-header">
        <div>
          <h2>Search Results</h2>
          <p class="meta" data-search-meta></p>
        </div>
        <div class="search-results-actions">
          <button type="button" data-clear-search>Clear Search</button>
          <button type="button" data-clear-results>Clear Results</button>
        </div>
      </div>

      <ul class="search-results" data-search-results></ul>
      <p data-search-empty hidden><em>No verses matched that search.</em></p>
    </section>

  <section class="card-panel section-spacer">
    <header class="chapter-header">
      <h2>{selectedBookName} {selectedChapter}</h2>
      <div class="chapter-header-actions">
        <button
          type="button"
          class="chapter-bookmark"
          data-chapter-bookmark
          aria-pressed="false"
          aria-label={`Bookmark ${selectedBookName} ${selectedChapter}`}
          title={`Bookmark ${selectedBookName} ${selectedChapter}`}
        >
          <svg class="chapter-bookmark-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M6.5 3h11a1 1 0 0 1 1 1v16.1a.85.85 0 0 1-1.3.72L12 17.55l-5.2 3.27A.85.85 0 0 1 5.5 20.1V4a1 1 0 0 1 1-1z" />
          </svg>
        </button>
        <div class="chapter-nav">
          {previousChapterHref ? (
            <a href={previousChapterHref} data-reader-nav>Previous</a>
          ) : (
            <span class="chapter-nav-disabled">Previous</span>
          )}
          {nextChapterHref ? <a href={nextChapterHref} data-reader-nav>Next</a> : <span class="chapter-nav-disabled">Next</span>}
        </div>
      </div>
    </header>
    {chapterAudioUrl ? (
      <div class="chapter-audio">
        <span class="chapter-audio-label">
          Listen to {selectedBookName} {selectedChapter}
        </span>
        <sermon-player class="chapter-audio-player" src={chapterAudioUrl}></sermon-player>
        <a class="chapter-audio-link" href={chapterAudioUrl} target="_blank" rel="noopener">
          Open MP3
        </a>
        <span class="chapter-audio-credit">Read by {CHAPTER_AUDIO_READER} · BSB</span>
      </div>
    ) : null}
    {chapterFootnoteCount > 0 ? (
      <div class="chapter-footnotes-controls" data-chapter-footnotes-controls>
        <p class="meta">
          {chapterFootnoteCount} verse{chapterFootnoteCount === 1 ? "" : "s"} with confession references in this chapter
        </p>
      </div>
    ) : null}

    {chapterVerses.length > 0 ? (
      <ol class="verse-list">
        {chapterVerses.map((verse) => {
          const footnote = chapterFootnotesByVerse.get(verse.verse);
          const changes = chapterChangesByVerse.get(verse.verse) ?? [];
          return (
            <li class:list={["verse-item", targetVerse === verse.verse && "is-target"]} id={`verse-${verse.verse}`}>
              <a
                href={`#verse-${verse.verse}`}
                class="verse-ref"
                data-share-verse
                data-reference={verse.reference}
                data-verse-number={verse.verse}
                data-verse-copy-text={verse.text}
                aria-label={`Share ${verse.reference}`}
                title={`Share ${verse.reference}`}
              >
                {verse.verse}
              </a>
              <span class="verse-text" data-verse-text>{verse.text}</span>
              {changes.length > 0 ? (
                <span class="verse-change" data-verse-change>
                  <button
                    type="button"
                    class="verse-change-pill"
                    aria-label={`${changes.length} BSB transformation${changes.length === 1 ? "" : "s"} for ${verse.reference}`}
                    aria-describedby={`verse-change-${verse.verse}`}
                  >
                    ?
                  </button>
                  <span class="verse-change-tooltip" id={`verse-change-${verse.verse}`} role="tooltip">
                    <span class="verse-change-tooltip-title">
                      {changes.length === 1 ? "BSB transformation" : `${changes.length} BSB transformations`}
                    </span>
                    {changes.map((change) => (
                      <span class="verse-change-entry">
                        <span class="verse-change-type">{change.typeLabel}</span>
                        {change.reason ? <span class="verse-change-reason">{change.reason}</span> : null}
                        <span class="verse-change-row">
                          <span class="verse-change-label">Before</span>
                          <span>{change.before}</span>
                        </span>
                        <span class="verse-change-row">
                          <span class="verse-change-label">After</span>
                          <span>{change.after}</span>
                        </span>
                      </span>
                    ))}
                  </span>
                </span>
              ) : null}
              {footnote ? (
                <span class="verse-footnotes" data-verse-footnotes>
                  <a
                    class="verse-footnote-pill"
                    href={footnote.href}
                    title={`Open ${footnote.referenceCount} confession reference${footnote.referenceCount === 1 ? "" : "s"} for ${selectedBookName} ${selectedChapter}:${verse.verse}`}
                    aria-label={`Open confession references for ${selectedBookName} ${selectedChapter}:${verse.verse}`}
                  >
                    MORE
                  </a>
                </span>
              ) : null}
            </li>
          );
        })}
      </ol>
    ) : (
      <p><em>No verses available for this chapter.</em></p>
    )}

    <div class="chapter-nav chapter-nav-bottom">
      {previousChapterHref ? (
        <a href={previousChapterHref} data-reader-nav>Previous</a>
      ) : (
        <span class="chapter-nav-disabled">Previous</span>
      )}
      {nextChapterHref ? <a href={nextChapterHref} data-reader-nav>Next</a> : <span class="chapter-nav-disabled">Next</span>}
    </div>
  </section>

  <div
    class="verse-actionbar"
    data-verse-actionbar
    hidden
    role="region"
    aria-label="Verse selection actions"
  >
    <div class="verse-actionbar-inner">
      <div class="verse-actionbar-buttons">
        <button
          type="button"
          class="verse-actionbar-switch"
          data-actionbar-link
          role="switch"
          aria-checked="true"
          aria-label="Include verse link when copying or sharing"
          title="Include verse link when copying or sharing"
        >
          <span class="verse-actionbar-switch-track" aria-hidden="true">
            <span class="verse-actionbar-switch-thumb"></span>
          </span>
          <span>Link</span>
        </button>
        <button type="button" class="verse-actionbar-button" data-actionbar-range aria-pressed="false">
          Range
        </button>
        <button
          type="button"
          class="verse-actionbar-button"
          data-actionbar-bookmark
          aria-pressed="false"
        >
          Save
        </button>
        <button type="button" class="verse-actionbar-button" data-actionbar-copy>Copy</button>
        <button type="button" class="verse-actionbar-button" data-actionbar-share hidden>Share</button>
        <button
          type="button"
          class="verse-actionbar-button verse-actionbar-clear"
          data-actionbar-clear
          aria-label="Clear selection"
        >
          ✕
        </button>
      </div>
    </div>
  </div>

  <div
    id="book-catalog-data"
    data-book-catalog={bookCatalogJson}
    data-adjacent-chapters={adjacentChaptersJson}
    data-book-code={selectedBookCode}
    data-book-name={selectedBookName}
    data-chapter-number={String(selectedChapter)}
    hidden
  ></div>

  <script src="/sermon-player.js" is:inline defer></script>
  <script>
    import {
      findRecentChapter,
      isSameLocation,
      listBookmarks,
      markHref,
      readPosition,
      toggleBookmark,
      writePosition,
    } from "../../../lib/bible/readingMarks";
    import { parseSearchTerms as parseSharedSearchTerms } from "../../../lib/searchTerms";

    (() => {
      const catalogElement = document.getElementById("book-catalog-data");
      let bookCatalog = [];
      try {
        bookCatalog = JSON.parse(catalogElement?.dataset.bookCatalog || "[]");
      } catch {
        bookCatalog = [];
      }
      let adjacentChapters = [];
      try {
        adjacentChapters = JSON.parse(catalogElement?.dataset.adjacentChapters || "[]");
      } catch {
        adjacentChapters = [];
      }
      const currentBookCode = String(catalogElement?.dataset.bookCode || "");
      const currentBookName = String(catalogElement?.dataset.bookName || "");
      const currentChapterNumber =
        Number.parseInt(String(catalogElement?.dataset.chapterNumber || "1"), 10) || 1;
      const chapterForm = document.querySelector("[data-chapter-form]");
      const bookSelect = document.querySelector("[data-book-select]");
      const chapterSelect = document.querySelector("[data-chapter-select]");
      const scopePills = Array.from(document.querySelectorAll("[data-scope-pill]"));
      const scopeInputs = Array.from(document.querySelectorAll("[data-scope-input]"));
      const readerNavLinks = Array.from(document.querySelectorAll("[data-reader-nav]"));
      const lookupForm = document.querySelector("[data-lookup-form]");
      const lookupInput = document.querySelector("[data-lookup-input]");
      const lookupSubmit = document.querySelector("[data-lookup-submit]");
      const searchSection = document.querySelector("[data-search-section]");
      const searchMeta = document.querySelector("[data-search-meta]");
      const searchResultsList = document.querySelector("[data-search-results]");
      const searchEmpty = document.querySelector("[data-search-empty]");
      const clearSearchButton = document.querySelector("[data-clear-search]");
      const clearResultsButton = document.querySelector("[data-clear-results]");
      const resumeBar = document.querySelector("[data-resume-bar]");
      const resumeBarRef = document.querySelector("[data-resume-bar-ref]");
      const resumeNote = document.querySelector("[data-resume-note]");
      const resumeNoteRef = document.querySelector("[data-resume-note-ref]");
      const chapterBookmarkButton = document.querySelector("[data-chapter-bookmark]");
      const readerScrollStorageKey = "bible-reader-scroll-to-chapter";
      const includeLinkStorageKey = "bible-copy-include-link";
      let bibleSearchIndexPromise = null;
      const feedbackTimers = new WeakMap();

      const escapeRegExp = (value) => String(value).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

      const normalizeForSearch = (value) =>
        String(value || "")
          .toLowerCase()
          .replace(/\u2018|\u2019/g, "'")
          .replace(/\u201c|\u201d/g, '"')
          .replace(/\u2013|\u2014/g, "-")
          .replace(/\s+/g, " ")
          .trim();

      // Shared with the confession search boxes; normalizeForSearch keeps the
      // terms folded the same way the verse text is.
      const parseSearchTerms = (rawQuery) =>
        parseSharedSearchTerms(rawQuery, normalizeForSearch);

      const getHighlightRegex = (terms) => {
        const pattern = terms
          .map((term) => {
            const escaped = escapeRegExp(term.value);
            return term.phrase ? escaped.replace(/\s+/g, "\\s+") : escaped;
          })
          .sort((a, b) => b.length - a.length)
          .join("|");

        return pattern ? new RegExp(pattern, "gi") : null;
      };

      const appendHighlightedText = (target, text, regex) => {
        const source = String(text || "");
        if (!regex) {
          target.append(document.createTextNode(source));
          return;
        }

        regex.lastIndex = 0;
        let cursor = 0;
        for (const match of source.matchAll(regex)) {
          const index = match.index ?? 0;
          const hit = match[0] || "";
          if (!hit) {
            continue;
          }
          if (index > cursor) {
            target.append(document.createTextNode(source.slice(cursor, index)));
          }
          const mark = document.createElement("mark");
          mark.className = "search-hit";
          mark.textContent = hit;
          target.append(mark);
          cursor = index + hit.length;
        }
        if (cursor < source.length) {
          target.append(document.createTextNode(source.slice(cursor)));
        }
      };

      const clearHighlights = (rootNode) => {
        if (!(rootNode instanceof Element)) {
          return;
        }
        for (const mark of Array.from(rootNode.querySelectorAll("mark.search-hit"))) {
          const parent = mark.parentNode;
          if (!parent) {
            continue;
          }
          parent.replaceChild(document.createTextNode(mark.textContent || ""), mark);
          parent.normalize();
        }
      };

      const highlightElementText = (element, regex) => {
        if (!(element instanceof HTMLElement)) {
          return;
        }
        clearHighlights(element);
        const textNodes = [];
        const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT, {
          acceptNode: (node) => {
            const value = node.nodeValue || "";
            if (!value.trim()) {
              return NodeFilter.FILTER_REJECT;
            }
            regex.lastIndex = 0;
            return regex.test(value) ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
          },
        });

        while (walker.nextNode()) {
          textNodes.push(walker.currentNode);
        }

        for (const node of textNodes) {
          const text = node.nodeValue || "";
          const fragment = document.createDocumentFragment();
          appendHighlightedText(fragment, text, regex);
          node.parentNode?.replaceChild(fragment, node);
        }
      };

      const getBibleSearchIndex = async () => {
        if (!bibleSearchIndexPromise) {
          bibleSearchIndexPromise = fetch("/bible-search.json")
            .then((response) => {
              if (!response.ok) {
                throw new Error(`Bible search index failed with ${response.status}`);
              }
              return response.json();
            })
            .then((payload) => (Array.isArray(payload?.verses) ? payload.verses : []));
        }
        return bibleSearchIndexPromise;
      };

      const parseScope = (value) => {
        if (value === "ot" || value === "nt") {
          return value;
        }
        return "all";
      };

      const getActiveScope = () => {
        const params = new URLSearchParams(window.location.search);
        return parseScope(String(params.get("scope") || "").trim().toLowerCase());
      };

      const getScopeSuffix = (scope) => (scope === "all" ? "" : `?scope=${scope}`);

      const buildChapterUrl = (bookCode, chapter, scope) =>
        `/bible/${encodeURIComponent(bookCode)}/${chapter}${getScopeSuffix(scope)}`;

      const getVerseShareUrl = (button) => {
        const verseNumber = String(button.dataset.verseNumber || "").trim();
        const url = new URL(window.location.pathname, window.location.origin);
        if (verseNumber) {
          url.hash = `verse-${verseNumber}`;
        }
        return url.toString();
      };

      const getVerseShareText = (button) => {
        const reference = String(button.dataset.reference || "").trim();
        const text = String(button.dataset.verseCopyText || "").trim();
        return [reference, text].filter(Boolean).join(" - ");
      };

      const setVerseActionFeedback = (trigger, label) => {
        const previousTimer = feedbackTimers.get(trigger);
        if (previousTimer) {
          window.clearTimeout(previousTimer);
        }

        if (trigger.classList.contains("verse-ref")) {
          if (!trigger.dataset.defaultAriaLabel) {
            trigger.dataset.defaultAriaLabel = trigger.getAttribute("aria-label") || "";
          }
          if (!trigger.dataset.defaultTitle) {
            trigger.dataset.defaultTitle = trigger.getAttribute("title") || "";
          }

          trigger.dataset.status = label;
          trigger.setAttribute("aria-label", `${label}: ${trigger.dataset.defaultAriaLabel || "verse"}`);
          trigger.setAttribute("title", label);

          const timer = window.setTimeout(() => {
            delete trigger.dataset.status;
            trigger.setAttribute("aria-label", trigger.dataset.defaultAriaLabel || "");
            trigger.setAttribute("title", trigger.dataset.defaultTitle || "");
            feedbackTimers.delete(trigger);
          }, 1400);
          feedbackTimers.set(trigger, timer);
          return;
        }

        if (!trigger.dataset.defaultLabel) {
          trigger.dataset.defaultLabel = trigger.textContent || "";
        }

        trigger.textContent = label;
        const timer = window.setTimeout(() => {
          trigger.textContent = trigger.dataset.defaultLabel || "";
          feedbackTimers.delete(trigger);
        }, 1400);
        feedbackTimers.set(trigger, timer);
      };

      const getHeaderOffset = () => {
        const header = document.querySelector(".top");
        return header instanceof HTMLElement ? Math.ceil(header.getBoundingClientRect().height) : 0;
      };

      const copyText = async (value) => {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(value);
          return;
        }

        const textArea = document.createElement("textarea");
        textArea.value = value;
        textArea.setAttribute("readonly", "");
        textArea.style.position = "fixed";
        textArea.style.left = "-9999px";
        document.body.appendChild(textArea);
        textArea.select();

        try {
          document.execCommand("copy");
        } finally {
          textArea.remove();
        }
      };

      // --- Verse selection & range sharing ---
      const actionBar = document.querySelector("[data-verse-actionbar]");
      const rangeButton = document.querySelector("[data-actionbar-range]");
      const linkButton = document.querySelector("[data-actionbar-link]");
      const copyButton = document.querySelector("[data-actionbar-copy]");
      const shareButton = document.querySelector("[data-actionbar-share]");
      const clearButton = document.querySelector("[data-actionbar-clear]");
      const bookmarkButton = document.querySelector("[data-actionbar-bookmark]");

      // Including the verse link is a sticky preference rather than a per-copy
      // choice: people are consistent about wanting it (texting) or not (notes).
      const readIncludeLink = () => {
        try {
          return window.localStorage.getItem(includeLinkStorageKey) !== "0";
        } catch {
          return true;
        }
      };

      const writeIncludeLink = (value) => {
        try {
          window.localStorage.setItem(includeLinkStorageKey, value ? "1" : "0");
        } catch {
          // preference is best-effort; keep the toggle working for this session
        }
      };

      let anchorVerse = Number.NaN;
      let endVerse = Number.NaN;
      let rangeArmed = false;
      let includeLink = readIncludeLink();

      const getVerseButton = (verseNumber) =>
        document.querySelector(`[data-share-verse][data-verse-number="${verseNumber}"]`);

      const getSelectionBounds = () => {
        if (!Number.isFinite(anchorVerse)) {
          return null;
        }
        if (!Number.isFinite(endVerse)) {
          return { start: anchorVerse, end: anchorVerse };
        }
        return { start: Math.min(anchorVerse, endVerse), end: Math.max(anchorVerse, endVerse) };
      };

      const buildSelectionReference = (start, end) => {
        const startButton = getVerseButton(start);
        const reference = String(startButton?.dataset.reference || "").trim();
        if (start === end) {
          return reference;
        }
        const match = reference.match(/^(.*:)(\d+)\s*$/);
        if (match) {
          return `${match[1]}${start}–${end}`;
        }
        return reference ? `${reference}–${end}` : "";
      };

      const collectRangeVerses = (start, end) => {
        const verses = [];
        for (let verseNumber = start; verseNumber <= end; verseNumber += 1) {
          const button = getVerseButton(verseNumber);
          if (!button) {
            continue;
          }
          verses.push({
            number: verseNumber,
            text: String(button.dataset.verseCopyText || "").trim(),
          });
        }
        return verses;
      };

      const buildSelectionShareText = (bounds) => {
        const startButton = getVerseButton(bounds.start);
        if (bounds.start === bounds.end) {
          return startButton ? getVerseShareText(startButton) : "";
        }
        const header = buildSelectionReference(bounds.start, bounds.end);
        const body = collectRangeVerses(bounds.start, bounds.end)
          .map((verse) => `${verse.number} ${verse.text}`.trim())
          .join("\n");
        return [header, body].filter(Boolean).join("\n");
      };

      const buildSelectionShareUrl = (bounds) => {
        const startButton = getVerseButton(bounds.start);
        return startButton ? getVerseShareUrl(startButton) : window.location.href;
      };

      // --- Bookmarks ---
      const formatReference = (verseNumber) =>
        verseNumber > 0
          ? `${currentBookName} ${currentChapterNumber}:${verseNumber}`
          : `${currentBookName} ${currentChapterNumber}`;

      const buildMark = (verseNumber, label) => ({
        book: currentBookCode,
        chapter: currentChapterNumber,
        verse: verseNumber > 0 ? verseNumber : 0,
        label: label || formatReference(verseNumber),
      });

      const getChapterMark = () => buildMark(0, "");

      // A range selection bookmarks its opening verse, but keeps the range in the
      // label so the list reads the way the reader selected it.
      const getSelectionMark = () => {
        const bounds = getSelectionBounds();
        if (!bounds) {
          return null;
        }
        return buildMark(bounds.start, buildSelectionReference(bounds.start, bounds.end));
      };

      let bookmarks = listBookmarks();

      const isBookmarked = (mark) =>
        Boolean(mark) && bookmarks.some((entry) => isSameLocation(entry, mark));

      // The bar answers "you were away — here is where you stopped", so it only
      // belongs on the first reader page of a browsing session. Once this session
      // has recorded a position the reader is mid-read, and pointing back at the
      // chapter they just paged away from would be noise rather than help.
      const sessionReadingKey = "bible-session-reading";

      const hasReadThisSession = () => {
        try {
          return window.sessionStorage.getItem(sessionReadingKey) === "1";
        } catch {
          return false;
        }
      };

      const markSessionReading = () => {
        try {
          window.sessionStorage.setItem(sessionReadingKey, "1");
        } catch {
          // ignore
        }
      };

      const startedSessionFresh = !hasReadThisSession();

      // Snapshotted before this page records anything, so the cue keeps
      // describing where the reader *was* instead of flipping as they read.
      const positionAtArrival = readPosition();

      // Two forms, because resuming lands you *on* your saved chapter: a link
      // when the saved place is elsewhere, and a plain confirmation when you are
      // already standing on it. Without the second form the cue almost never
      // appears, since every entry point resumes.
      const renderResumeBar = () => {
        const position = positionAtArrival || readPosition();
        const show = startedSessionFresh && Boolean(position);
        const here =
          show &&
          position.book === currentBookCode &&
          position.chapter === currentChapterNumber;
        const elsewhere = show && !here;

        if (resumeBar instanceof HTMLAnchorElement) {
          resumeBar.hidden = !elsewhere;
          if (elsewhere) {
            resumeBar.href = markHref(position, "resume");
          }
        }
        if (resumeBarRef instanceof HTMLElement && elsewhere) {
          resumeBarRef.textContent = position.label;
        }

        if (resumeNote instanceof HTMLElement) {
          resumeNote.hidden = !here;
        }
        if (resumeNoteRef instanceof HTMLElement && here) {
          resumeNoteRef.textContent = position.label;
        }
      };

      const renderChapterBookmarkState = () => {
        if (!(chapterBookmarkButton instanceof HTMLButtonElement)) {
          return;
        }
        const saved = isBookmarked(getChapterMark());
        const reference = formatReference(0);
        chapterBookmarkButton.setAttribute("aria-pressed", saved ? "true" : "false");
        chapterBookmarkButton.setAttribute(
          "aria-label",
          saved ? `Remove bookmark ${reference}` : `Bookmark ${reference}`
        );
        chapterBookmarkButton.title = saved ? `Bookmarked — ${reference}` : `Bookmark ${reference}`;
      };

      const renderSelectionBookmarkState = () => {
        if (!(bookmarkButton instanceof HTMLButtonElement)) {
          return;
        }
        const saved = isBookmarked(getSelectionMark());
        bookmarkButton.setAttribute("aria-pressed", saved ? "true" : "false");
        bookmarkButton.textContent = saved ? "Saved" : "Save";
      };

      const renderMarks = () => {
        renderChapterBookmarkState();
        renderSelectionBookmarkState();
      };

      const positionActionBar = () => {
        if (!(actionBar instanceof HTMLElement) || actionBar.hidden) {
          return;
        }
        const anchorNumber = Number.isFinite(endVerse) ? endVerse : anchorVerse;
        const anchorItem = document.getElementById(`verse-${anchorNumber}`);
        if (!(anchorItem instanceof HTMLElement)) {
          return;
        }

        const margin = 8;
        const gap = 8;
        const headerOffset = getHeaderOffset();
        const itemRect = anchorItem.getBoundingClientRect();
        const barWidth = actionBar.offsetWidth;
        const barHeight = actionBar.offsetHeight;
        const isCompact = window.matchMedia("(max-width: 32rem)").matches;

        let top;
        if (isCompact) {
          // Narrow screens: overlay the selected verse's own first line instead of
          // sitting below it, so the next verse stays visible while picking a range.
          top = Math.min(itemRect.top, window.innerHeight - margin - barHeight);
          top = Math.max(top, headerOffset + margin);
        } else {
          // Vertical: prefer just below the verse line; flip above near the bottom edge.
          top = itemRect.bottom + gap;
          if (top + barHeight > window.innerHeight - margin) {
            const above = itemRect.top - gap - barHeight;
            top =
              above >= headerOffset + margin
                ? above
                : Math.max(headerOffset + margin, window.innerHeight - margin - barHeight);
          }
        }

        // Horizontal: start past the verse-number gutter so numbers stay visible/tappable.
        const refEl = anchorItem.querySelector(".verse-ref");
        let left =
          refEl instanceof HTMLElement
            ? refEl.getBoundingClientRect().right + 6
            : itemRect.left + 24;
        if (left + barWidth > window.innerWidth - margin) {
          left = window.innerWidth - margin - barWidth;
        }
        if (left < margin) {
          left = margin;
        }

        actionBar.style.top = `${Math.round(top)}px`;
        actionBar.style.left = `${Math.round(left)}px`;
      };

      const renderSelection = () => {
        for (const item of Array.from(document.querySelectorAll(".verse-item.is-selected"))) {
          item.classList.remove("is-selected");
        }

        const bounds = getSelectionBounds();
        if (!bounds) {
          if (actionBar instanceof HTMLElement) {
            actionBar.hidden = true;
          }
          return;
        }

        for (let verseNumber = bounds.start; verseNumber <= bounds.end; verseNumber += 1) {
          document.getElementById(`verse-${verseNumber}`)?.classList.add("is-selected");
        }

        if (actionBar instanceof HTMLElement) {
          actionBar.hidden = false;
        }
        if (rangeButton instanceof HTMLButtonElement) {
          rangeButton.setAttribute("aria-pressed", rangeArmed ? "true" : "false");
        }
        if (linkButton instanceof HTMLButtonElement) {
          linkButton.setAttribute("aria-checked", includeLink ? "true" : "false");
        }
        renderSelectionBookmarkState();

        positionActionBar();
      };

      const clearSelection = () => {
        anchorVerse = Number.NaN;
        endVerse = Number.NaN;
        rangeArmed = false;
        renderSelection();
      };

      const onVerseTap = (button) => {
        const verseNumber = Number.parseInt(String(button.dataset.verseNumber || ""), 10);
        if (!Number.isFinite(verseNumber)) {
          return;
        }

        if (rangeArmed && Number.isFinite(anchorVerse)) {
          endVerse = verseNumber;
          rangeArmed = false;
        } else if (
          Number.isFinite(anchorVerse) &&
          !Number.isFinite(endVerse) &&
          verseNumber === anchorVerse
        ) {
          clearSelection();
          return;
        } else {
          anchorVerse = verseNumber;
          endVerse = Number.NaN;
          rangeArmed = false;
        }

        renderSelection();
      };

      const handleSelectionAction = async (kind, feedbackTarget) => {
        const bounds = getSelectionBounds();
        if (!bounds) {
          return;
        }
        const text = buildSelectionShareText(bounds);
        const url = includeLink ? buildSelectionShareUrl(bounds) : "";
        const copyValue = [text, url].filter(Boolean).join("\n");

        if (kind === "share" && navigator.share) {
          try {
            // Omit `url` entirely when the link is off — an empty string still
            // shows up as a blank attachment in some share sheets.
            const payload = {
              title: buildSelectionReference(bounds.start, bounds.end) || "Bible passage",
              text,
            };
            if (url) {
              payload.url = url;
            }
            await navigator.share(payload);
          } catch {
            // user dismissed share sheet or it failed; leave selection intact
          }
          return;
        }

        try {
          await copyText(copyValue);
          setVerseActionFeedback(feedbackTarget, "Copied!");
        } catch {
          setVerseActionFeedback(feedbackTarget, "Failed");
        }
      };

      const requestReaderScroll = () => {
        try {
          window.sessionStorage.setItem(readerScrollStorageKey, "1");
        } catch {
          // ignore
        }
      };

      const syncScopeInputs = (scope) => {
        for (const input of scopeInputs) {
          if (!(input instanceof HTMLInputElement)) {
            continue;
          }
          input.value = scope;
        }
      };

      const setActiveScopePill = (scope) => {
        for (const pill of scopePills) {
          if (!(pill instanceof HTMLElement)) {
            continue;
          }
          const pillScope = String(pill.dataset.scope || "all");
          pill.classList.toggle("is-active", pillScope === scope);
          if (pill instanceof HTMLButtonElement) {
            pill.setAttribute("aria-pressed", pillScope === scope ? "true" : "false");
          }
        }
      };

      const getScopedBooks = (scope) =>
        scope === "all" ? bookCatalog : bookCatalog.filter((book) => book.testament === scope);

      const populateBookOptions = (scope, preferredBookCode) => {
        if (!(bookSelect instanceof HTMLSelectElement)) {
          return "";
        }

        const scopedBooks = getScopedBooks(scope);
        const fallbackBookCode = scopedBooks[0]?.code || "";
        const activeBookCode = scopedBooks.some((book) => book.code === preferredBookCode)
          ? preferredBookCode
          : fallbackBookCode;

        bookSelect.innerHTML = "";
        for (const book of scopedBooks) {
          const option = document.createElement("option");
          option.value = book.code;
          option.textContent = book.name;
          option.selected = book.code === activeBookCode;
          bookSelect.append(option);
        }

        return activeBookCode;
      };

      const populateChapterOptions = (bookCode, preferredChapter) => {
        if (!(chapterSelect instanceof HTMLSelectElement)) {
          return 1;
        }

        const selectedBook = bookCatalog.find((book) => book.code === bookCode);
        const maxChapter = selectedBook?.chapterCount || 1;
        const safeChapter = Math.min(Math.max(preferredChapter, 1), maxChapter);

        chapterSelect.innerHTML = "";
        for (let chapterNumber = 1; chapterNumber <= maxChapter; chapterNumber += 1) {
          const option = document.createElement("option");
          option.value = String(chapterNumber);
          option.textContent = String(chapterNumber);
          option.selected = chapterNumber === safeChapter;
          chapterSelect.append(option);
        }

        return safeChapter;
      };

      let activeScope = getActiveScope();
      setActiveScopePill(activeScope);
      syncScopeInputs(activeScope);

      if (
        chapterForm instanceof HTMLFormElement &&
        bookSelect instanceof HTMLSelectElement &&
        chapterSelect instanceof HTMLSelectElement
      ) {
        const initialBookCode = String(bookSelect.value || "");
        const initialChapterValue = Number.parseInt(String(chapterSelect.value || "1"), 10);
        const selectedBookCode = populateBookOptions(activeScope, initialBookCode);
        populateChapterOptions(
          selectedBookCode,
          Number.isFinite(initialChapterValue) && initialChapterValue > 0 ? initialChapterValue : 1
        );

        bookSelect.addEventListener("change", () => {
          const nextBookCode = String(bookSelect.value || "");
          if (!nextBookCode) {
            return;
          }
          populateChapterOptions(nextBookCode, 1);
          window.location.assign(buildChapterUrl(nextBookCode, 1, activeScope));
        });

        chapterSelect.addEventListener("change", () => {
          const nextBookCode = String(bookSelect.value || "");
          if (!nextBookCode) {
            return;
          }
          const nextChapter = Number.parseInt(String(chapterSelect.value || "1"), 10);
          const safeChapter = Number.isFinite(nextChapter) && nextChapter > 0 ? nextChapter : 1;
          window.location.assign(buildChapterUrl(nextBookCode, safeChapter, activeScope));
        });
      }

      for (const pill of scopePills) {
        if (!(pill instanceof HTMLButtonElement)) {
          continue;
        }
        pill.addEventListener("click", () => {
          const nextScope = parseScope(String(pill.dataset.scope || "all"));
          if (nextScope === activeScope) {
            return;
          }
          activeScope = nextScope;
          setActiveScopePill(activeScope);
          syncScopeInputs(activeScope);

          if (
            chapterForm instanceof HTMLFormElement &&
            bookSelect instanceof HTMLSelectElement &&
            chapterSelect instanceof HTMLSelectElement
          ) {
            const currentBookCode = String(bookSelect.value || "");
            const scopedBookCode = populateBookOptions(activeScope, currentBookCode);
            if (!scopedBookCode) {
              return;
            }
            populateChapterOptions(scopedBookCode, 1);
            window.location.assign(buildChapterUrl(scopedBookCode, 1, activeScope));
          }
        });
      }

      for (const link of readerNavLinks) {
        if (!(link instanceof HTMLAnchorElement)) {
          continue;
        }
        link.addEventListener("click", requestReaderScroll);
      }

      const buildResultHref = (verse, query, scope) => {
        const params = new URLSearchParams();
        if (query) {
          params.set("q", query);
        }
        if (scope !== "all") {
          params.set("scope", scope);
        }
        const queryString = params.toString();
        return `/bible/${encodeURIComponent(verse.bookCode)}/${verse.chapter}${
          queryString ? `?${queryString}` : ""
        }#verse-${verse.verse}`;
      };

      const verseMatchesSearch = (verse, terms, scope) => {
        if (scope !== "all" && verse.testament !== scope) {
          return false;
        }

        const haystack = normalizeForSearch(`${verse.reference} ${verse.text}`);
        return terms.every((term) => haystack.includes(term.value));
      };

      const renderSearchResults = (results, rawQuery, scope, regex, ignored = []) => {
        if (!(searchSection instanceof HTMLElement)) {
          return;
        }

        searchSection.hidden = false;

        if (searchMeta instanceof HTMLElement) {
          const capped = results.length >= 250 ? "First 250" : String(results.length);
          // Say which words were skipped rather than silently changing the query.
          const skipped = ignored.length
            ? ` · ignored ${ignored.map((word) => `"${word}"`).join(", ")} — quote to match exactly`
            : "";
          searchMeta.textContent = `${capped} result${results.length === 1 ? "" : "s"} shown for "${rawQuery}"${skipped}`;
        }

        if (searchResultsList instanceof HTMLElement) {
          searchResultsList.textContent = "";
          for (const result of results) {
            const item = document.createElement("li");
            const link = document.createElement("a");
            link.className = "search-result-card";
            link.href = buildResultHref(result, rawQuery, scope);

            const reference = document.createElement("span");
            reference.className = "search-result-reference";
            appendHighlightedText(reference, result.reference, regex);

            const text = document.createElement("span");
            text.className = "search-result-text";
            appendHighlightedText(text, result.text, regex);

            link.append(reference, text);
            item.append(link);
            searchResultsList.append(item);
          }
        }

        if (searchEmpty instanceof HTMLElement) {
          searchEmpty.hidden = results.length > 0;
        }
      };

      const highlightCurrentChapterSearchHits = (terms) => {
        const regex = getHighlightRegex(terms);
        for (const verseText of Array.from(document.querySelectorAll("[data-verse-text]"))) {
          if (!(verseText instanceof HTMLElement)) {
            continue;
          }
          clearHighlights(verseText);
          if (regex) {
            highlightElementText(verseText, regex);
          }
        }
      };

      const hideSearchResults = () => {
        if (searchSection instanceof HTMLElement) {
          searchSection.hidden = true;
        }
        if (searchResultsList instanceof HTMLElement) {
          searchResultsList.textContent = "";
        }
        if (searchMeta instanceof HTMLElement) {
          searchMeta.textContent = "";
        }
        if (searchEmpty instanceof HTMLElement) {
          searchEmpty.hidden = true;
        }
      };

      const clearSearch = () => {
        if (lookupInput instanceof HTMLInputElement) {
          lookupInput.value = "";
          lookupInput.focus();
        }

        hideSearchResults();
        highlightCurrentChapterSearchHits([]);

        const params = new URLSearchParams(window.location.search);
        params.delete("q");
        params.delete("lookup");

        const queryString = params.toString();
        window.history.replaceState(
          {},
          "",
          `${window.location.pathname}${queryString ? `?${queryString}` : ""}${window.location.hash}`
        );
      };

      const runBibleSearchFromUrl = async () => {
        const params = new URLSearchParams(window.location.search);
        const rawQuery = String(params.get("q") || "").trim();
        if (lookupInput instanceof HTMLInputElement) {
          lookupInput.value = rawQuery || String(params.get("ref") || "").trim();
        }

        if (!rawQuery) {
          if (searchSection instanceof HTMLElement) {
            searchSection.hidden = true;
          }
          highlightCurrentChapterSearchHits([]);
          return;
        }

        const { terms, ignored } = parseSearchTerms(rawQuery);
        if (terms.length === 0) {
          return;
        }

        const scope = getActiveScope();
        const regex = getHighlightRegex(terms);
        highlightCurrentChapterSearchHits(terms);

        try {
          const index = await getBibleSearchIndex();
          const results = [];
          for (const verse of index) {
            if (verseMatchesSearch(verse, terms, scope)) {
              results.push(verse);
              if (results.length >= 250) {
                break;
              }
            }
          }
          renderSearchResults(results, rawQuery, scope, regex, ignored);
        } catch {
          if (searchSection instanceof HTMLElement) {
            searchSection.hidden = false;
          }
          if (searchMeta instanceof HTMLElement) {
            searchMeta.textContent = `Search index could not be loaded for "${rawQuery}".`;
          }
          if (searchResultsList instanceof HTMLElement) {
            searchResultsList.textContent = "";
          }
          if (searchEmpty instanceof HTMLElement) {
            searchEmpty.hidden = true;
          }
        }
      };

      if (
        lookupForm instanceof HTMLFormElement &&
        lookupInput instanceof HTMLInputElement &&
        lookupSubmit instanceof HTMLButtonElement
      ) {
        lookupInput.addEventListener("keydown", (event) => {
          if (event.key !== "Enter" || event.shiftKey || event.altKey || event.ctrlKey || event.metaKey) {
            return;
          }
          event.preventDefault();
          lookupForm.requestSubmit(lookupSubmit);
        });
      }

      if (clearSearchButton instanceof HTMLButtonElement) {
        clearSearchButton.addEventListener("click", clearSearch);
      }

      if (clearResultsButton instanceof HTMLButtonElement) {
        clearResultsButton.addEventListener("click", () => {
          hideSearchResults();
        });
      }

      document.addEventListener("click", (event) => {
        const trigger = event.target?.closest?.("[data-share-verse]");
        if (!(trigger instanceof HTMLElement)) {
          return;
        }

        event.preventDefault();
        onVerseTap(trigger);
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && getSelectionBounds()) {
          clearSelection();
          return;
        }

        if (event.key !== " " && event.key !== "Spacebar" && event.key !== "Enter") {
          return;
        }

        const trigger = event.target?.closest?.("[data-share-verse]");
        if (!(trigger instanceof HTMLElement)) {
          return;
        }

        event.preventDefault();
        onVerseTap(trigger);
      });

      if (shareButton instanceof HTMLElement && navigator.share) {
        shareButton.hidden = false;
      }

      if (linkButton instanceof HTMLButtonElement) {
        linkButton.addEventListener("click", () => {
          includeLink = !includeLink;
          writeIncludeLink(includeLink);
          renderSelection();
        });
      }

      if (rangeButton instanceof HTMLButtonElement) {
        rangeButton.addEventListener("click", () => {
          if (!Number.isFinite(anchorVerse)) {
            return;
          }
          rangeArmed = !rangeArmed;
          if (rangeArmed) {
            endVerse = Number.NaN;
          }
          renderSelection();
        });
      }

      if (copyButton instanceof HTMLButtonElement) {
        copyButton.addEventListener("click", () => {
          handleSelectionAction("copy", copyButton);
        });
      }

      if (shareButton instanceof HTMLButtonElement) {
        shareButton.addEventListener("click", () => {
          handleSelectionAction("share", shareButton);
        });
      }

      if (clearButton instanceof HTMLButtonElement) {
        clearButton.addEventListener("click", () => {
          clearSelection();
        });
      }

      if (bookmarkButton instanceof HTMLButtonElement) {
        bookmarkButton.addEventListener("click", () => {
          const mark = getSelectionMark();
          if (!mark) {
            return;
          }
          bookmarks = toggleBookmark(mark).bookmarks;
          renderMarks();
        });
      }

      if (chapterBookmarkButton instanceof HTMLButtonElement) {
        chapterBookmarkButton.addEventListener("click", () => {
          bookmarks = toggleBookmark(getChapterMark()).bookmarks;
          renderMarks();
        });
      }

      renderMarks();
      renderResumeBar();

      // --- Reading position ---
      // A chapter opened deliberately — Previous/Next, the book and chapter
      // pickers, a typed URL, a resumed position — is where the reader is, and
      // counts the moment it opens. Reading Matthew 1 to 3 and closing the tab
      // therefore leaves the position on Matthew 3, even if each chapter was
      // only on screen for a moment.
      //
      // Arrivals that point *into* a chapter are different: a proof-text
      // reference, a shared verse link or a search hit is somewhere the reader
      // was sent rather than somewhere they chose, so those only count once
      // they have actually been scrolled.
      const positionParams = new URLSearchParams(window.location.search);
      const wasSentHere =
        positionParams.has("ref") ||
        positionParams.has("q") ||
        /^#verse-\d+$/.test(window.location.hash);
      const trackingStartedAt = Date.now();
      let trackingArmed = !wasSentHere;
      let lastWrittenVerse = 0;
      let positionFrame = 0;

      // Just past the arrival settle (below), so a resumed chapter records the
      // verse it landed on rather than the top of the page. The re-render is for
      // a first-ever visit, where there was no position to describe on load.
      window.setTimeout(() => {
        recordPosition();
        renderResumeBar();
      }, 400);

      const getTopmostVisibleVerse = () => {
        const cutoff = getHeaderOffset() + 12;
        let candidate = 0;
        for (const item of Array.from(document.querySelectorAll(".verse-item"))) {
          if (!(item instanceof HTMLElement)) {
            continue;
          }
          const rect = item.getBoundingClientRect();
          if (rect.bottom <= cutoff) {
            continue;
          }
          if (rect.top >= window.innerHeight) {
            break;
          }
          candidate = Number.parseInt(String(item.id || "").replace("verse-", ""), 10);
          break;
        }
        return Number.isFinite(candidate) && candidate > 0 ? candidate : 0;
      };

      function recordPosition() {
        if (!trackingArmed || !currentBookCode) {
          return;
        }
        const verseNumber = getTopmostVisibleVerse();
        if (verseNumber === lastWrittenVerse) {
          return;
        }
        // Scrolled past the last verse (bottom nav, footer): keep the verse we
        // already have rather than demoting the position to the chapter top.
        if (verseNumber === 0 && lastWrittenVerse > 0) {
          return;
        }
        lastWrittenVerse = verseNumber;
        markSessionReading();
        writePosition(
          {
            book: currentBookCode,
            chapter: currentChapterNumber,
            verse: verseNumber,
            label: formatReference(verseNumber),
          },
          adjacentChapters
        );
      }

      window.addEventListener(
        "scroll",
        () => {
          // The reader scrolls itself on arrival (verse targets, chapter header);
          // ignore that window so it cannot masquerade as the reader's own scroll.
          if (Date.now() - trackingStartedAt > 400) {
            trackingArmed = true;
          }
          if (positionFrame) {
            return;
          }
          positionFrame = window.requestAnimationFrame(() => {
            positionFrame = 0;
            recordPosition();
          });
        },
        { passive: true }
      );

      window.addEventListener("pagehide", recordPosition);
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "hidden") {
          recordPosition();
        }
      });

      window.addEventListener("scroll", positionActionBar, { passive: true });
      window.addEventListener("resize", positionActionBar);

      const parseVerseTarget = () => {
        const params = new URLSearchParams(window.location.search);
        const refValue = String(params.get("ref") || "").trim();
        if (refValue) {
          const normalized = refValue
            .toLowerCase()
            .replace(/\./g, "")
            .replace(/\u2013|\u2014/g, "-")
            .replace(/\s+/g, " ")
            .trim();
          const match = normalized.match(/^(.+?)\s+(\d+)(?::(\d+(?:-\d+)?))?$/);
          if (match) {
            const chapterFromRef = Number.parseInt(String(match[2] || ""), 10);
            const versePart = String(match[3] || "");
            const verseFromRef = versePart ? Number.parseInt(versePart.split("-")[0] || "", 10) : NaN;
            if (Number.isFinite(verseFromRef) && verseFromRef > 0) {
              return { verse: verseFromRef, source: "ref" };
            }
            const pathParts = window.location.pathname.split("/").filter(Boolean);
            const currentChapter = Number.parseInt(pathParts[pathParts.length - 1] || "", 10);
            if (Number.isFinite(chapterFromRef) && Number.isFinite(currentChapter) && currentChapter === 1) {
              return { verse: chapterFromRef, source: "ref" };
            }
          }
        }

        const hashMatch = window.location.hash.match(/^#verse-(\d+)$/);
        if (hashMatch) {
          const hashVerse = Number.parseInt(hashMatch[1] || "", 10);
          if (Number.isFinite(hashVerse) && hashVerse > 0) {
            return { verse: hashVerse, source: "hash" };
          }
        }

        return { verse: NaN, source: "none" };
      };

      const isVerseTopVisible = (target) => {
        const rect = target.getBoundingClientRect();
        const visibleTop = getHeaderOffset() + 12;
        const visibleBottom = window.innerHeight - 16;
        return rect.top >= visibleTop && rect.top < visibleBottom;
      };

      const scrollVerseBelowHeader = (target, behavior = "smooth") => {
        const rect = target.getBoundingClientRect();
        const targetTop = window.scrollY + rect.top - getHeaderOffset() - 18;
        window.scrollTo({
          top: Math.max(targetTop, 0),
          behavior,
        });
      };

      const scrollVerseIntoViewIfNeeded = (target, behavior = "smooth") => {
        if (!isVerseTopVisible(target)) {
          scrollVerseBelowHeader(target, behavior);
        }
      };

      const highlightVerse = (verseNumber, shouldScroll = true) => {
        if (!Number.isFinite(verseNumber) || verseNumber < 1) {
          return;
        }

        const target = document.getElementById(`verse-${verseNumber}`);
        if (!(target instanceof HTMLElement)) {
          return;
        }

        target.classList.add("is-target", "is-target-flash");

        if (shouldScroll) {
          scrollVerseIntoViewIfNeeded(target);
        }

        window.setTimeout(() => {
          target.classList.remove("is-target-flash");
        }, 1400);
      };

      const settleVerseIntoView = (verseNumber) => {
        if (!Number.isFinite(verseNumber) || verseNumber < 1) {
          return;
        }

        const scrollIfNeeded = () => {
          const target = document.getElementById(`verse-${verseNumber}`);
          if (target instanceof HTMLElement) {
            scrollVerseIntoViewIfNeeded(target, "auto");
          }
        };

        window.requestAnimationFrame(scrollIfNeeded);
        window.setTimeout(scrollIfNeeded, 80);
        window.setTimeout(scrollIfNeeded, 220);
      };

      const scrollChapterHeaderIntoView = () => {
        const chapterHeader = document.querySelector(".chapter-header");
        if (!(chapterHeader instanceof HTMLElement)) {
          return;
        }
        const chapterTop = window.scrollY + chapterHeader.getBoundingClientRect().top - getHeaderOffset() - 18;
        window.scrollTo({
          top: Math.max(chapterTop, 0),
          behavior: "auto",
        });
      };

      const settleChapterHeaderIntoView = () => {
        window.requestAnimationFrame(scrollChapterHeaderIntoView);
        window.setTimeout(scrollChapterHeaderIntoView, 80);
        window.setTimeout(scrollChapterHeaderIntoView, 220);
      };

      const shouldScrollToChapter = () => {
        try {
          const shouldScroll = window.sessionStorage.getItem(readerScrollStorageKey) === "1";
          window.sessionStorage.removeItem(readerScrollStorageKey);
          return shouldScroll;
        } catch {
          return false;
        }
      };

      const verseTarget = parseVerseTarget();
      if (verseTarget.source === "ref") {
        if (/^#verse-\d+$/.test(window.location.hash)) {
          window.history.replaceState({}, "", `${window.location.pathname}${window.location.search}`);
          settleChapterHeaderIntoView();
        }
        highlightVerse(verseTarget.verse, true);
      } else {
        highlightVerse(verseTarget.verse, verseTarget.source === "hash");
      }
      if (verseTarget.source === "hash") {
        settleVerseIntoView(verseTarget.verse);
      }

      if (verseTarget.source === "none" && shouldScrollToChapter()) {
        settleChapterHeaderIntoView();
      }

      // Resuming: scroll to the stored verse without the target highlight, which
      // belongs to links someone followed here, and drop ?resume=1 so the URL
      // stays shareable.
      if (verseTarget.source === "none") {
        const params = new URLSearchParams(window.location.search);
        if (params.get("resume") === "1") {
          // Looked up per chapter rather than taking the newest position: any of
          // the three "continue reading" rows can be opened, and each restores
          // the verse it was left on.
          const position = findRecentChapter(currentBookCode, currentChapterNumber);
          if (position && position.verse > 1) {
            lastWrittenVerse = position.verse;
            settleVerseIntoView(position.verse);
          }

          params.delete("resume");
          const remaining = params.toString();
          window.history.replaceState(
            {},
            "",
            `${window.location.pathname}${remaining ? `?${remaining}` : ""}${window.location.hash}`
          );
        }
      }

      runBibleSearchFromUrl();
    })();
  </script>
</Main>

