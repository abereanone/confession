---
// Side-by-side comparison of the Westminster Confession, the Savoy Declaration
// and the Second London Baptist Confession.
//
// One static page per combination (three pairs plus the three-way), so every
// view has a shareable URL. Column selection is a link between those pages
// rather than client-side state — the alignment is computed at build time and a
// two-column view is a projection of the same three-way alignment, so the text
// does not reflow when a column is dropped.

import Main from "../../layouts/Main.astro";
import CompareRow from "../../components/CompareRow.astro";
import {
  DOC_LABELS,
  allCombos,
  buildComparison,
  comboSlug,
  parseCombo,
} from "../../lib/compare/compare";

export function getStaticPaths() {
  return allCombos().map((docs) => ({ params: { combo: comboSlug(docs) } }));
}

const { combo } = Astro.params;
const docs = parseCombo(combo ?? "");
if (!docs) return Astro.redirect("/compare/wcf-savoy-lbcf/");

// TODO(scaffold): wire these to querystring or a client toggle. `foldArchaic`
// especially deserves a control — off, it shows the 1689's copy-editing hand;
// on, it shows only where the doctrine moved.
const groups = buildComparison(docs, { foldArchaic: true, differencesOnly: false });

const title = docs.map((doc) => DOC_LABELS[doc].short).join(" vs ");

/**
 * A row's label in the jump menu. Every reference the row covers is shown,
 * because the numbering diverges after chapter 19 — Westminster 20.1 is Savoy
 * 21.1 — so a single number would be ambiguous, and a reader who arrives
 * thinking "1689 26.12" needs to find it under that number.
 *
 * Rows are listed once each, grouped under their chapter heading, rather than
 * once per confession: the page compares aligned rows, so listing a row three
 * times would offer three routes to the same place.
 */
function rowLabel(row: (typeof groups)[number]["rows"][number]): string {
  const parts = docs.map((doc) => {
    const cell = row.cells[doc];
    return cell ? `${DOC_LABELS[doc].short} ${cell.refs.join(", ")}` : `${DOC_LABELS[doc].short} —`;
  });
  return parts.join("  ·  ");
}
---

<Main title={`${title} | Confessions Hub`}>
  <section class="compare card-panel" data-compare data-show-punctuation="false" id="top">
    <ul class="legend" aria-label="What the colours mean">
      {
        docs.map((doc) => (
          <li data-confession={DOC_LABELS[doc].slug}>
            <span class="swatch swatch-unique" aria-hidden="true" />
            Only in {DOC_LABELS[doc].short}
          </li>
        ))
      }
      {
        docs.length > 2 && (
          <li>
            <span class="swatch swatch-shared" aria-hidden="true" />
            Two agree, the third differs
          </li>
        )
      }
    </ul>

    <h1>{title}</h1>
    <p class="lede">
      {docs.map((doc) => DOC_LABELS[doc].full).join(", ")} aligned paragraph by paragraph, with
      differing wording marked.
    </p>

    <div class="toolbar">
      <nav class="combo-switch" aria-label="Choose confessions to compare">
        {
          allCombos().map((option) => {
            const slug = comboSlug(option);
            const current = slug === comboSlug(docs);
            return (
              <a href={`/compare/${slug}/`} aria-current={current ? "page" : undefined}>
                {option.map((doc) => DOC_LABELS[doc].short).join(" + ")}
              </a>
            );
          })
        }
      </nav>

      <label class="control">
        <input type="checkbox" data-punctuation-toggle />
        Include punctuation
      </label>
    </div>

    <div class="jump-control">
      <label for="row-select">Jump to paragraph</label>
      <select id="row-select">
        <option value="">Select a paragraph</option>
        {
          groups.map((group) => (
            <optgroup label={group.label}>
              {group.rows.map((row) => (
                <option value={row.id}>{rowLabel(row)}</option>
              ))}
            </optgroup>
          ))
        }
      </select>
    </div>

    {
      groups.map((group) => (
        <section class="compare-group" id={group.id}>
          <h2>{group.label}</h2>
          <p class="chapter-line">
            {docs
              .map((doc) => {
                const chapters = group.chapters[doc];
                const where = chapters?.length ? `ch. ${chapters.join(", ")}` : "—";
                return `${DOC_LABELS[doc].short} ${where}`;
              })
              .join("  ·  ")}
          </p>
          {group.note && <p class="group-note">{group.note}</p>}
          {group.rows.map((row) => (
            <CompareRow row={row} docs={docs} backToTop />
          ))}
        </section>
      ))
    }
  </section>
</Main>

<script>
  // Jump menu. Navigating by hash rather than scrollIntoView so the row also
  // picks up its :target highlight, and so the browser honours the
  // scroll-margin-top that keeps the row clear of the header and the sticky key.
  (() => {
    const select = document.getElementById("row-select");
    if (!(select instanceof HTMLSelectElement)) return;

    select.addEventListener("change", () => {
      const id = select.value;
      if (!id) return;
      if (document.getElementById(id)) window.location.hash = id;
    });
  })();
</script>

<script>
  // Keep the sticky colour key clear of the site header, whose height changes
  // when it wraps. Cheaper and more reliable than guessing a fixed offset.
  (() => {
    const header = document.querySelector(".top");
    if (!(header instanceof HTMLElement)) return;

    const setOffset = () => {
      const height = Math.ceil(header.getBoundingClientRect().height);
      document.documentElement.style.setProperty("--compare-header-offset", `${height}px`);
    };

    setOffset();
    window.addEventListener("resize", setOffset);
    if ("ResizeObserver" in window) new ResizeObserver(setOffset).observe(header);
  })();
</script>

<script>
  // Punctuation toggle. The page ships both agreement figures on every row, so
  // flipping the setting is a class change plus a number swap — no re-render,
  // and it still works if the preference cannot be stored.
  (() => {
    const root = document.querySelector("[data-compare]");
    const toggle = document.querySelector("[data-punctuation-toggle]");
    if (!(root instanceof HTMLElement) || !(toggle instanceof HTMLInputElement)) return;

    const storageKey = "compare-show-punctuation";

    const read = () => {
      try {
        return window.localStorage.getItem(storageKey) === "1";
      } catch {
        return false;
      }
    };

    const write = (value) => {
      try {
        window.localStorage.setItem(storageKey, value ? "1" : "0");
      } catch {
        // preference is best-effort; the toggle still works this session
      }
    };

    const apply = (show) => {
      root.dataset.showPunctuation = show ? "true" : "false";
      for (const node of document.querySelectorAll("[data-agreement]")) {
        if (!(node instanceof HTMLElement)) continue;
        const value = show ? node.dataset.all : node.dataset.words;
        node.textContent = `${value}% alike`;
      }
    };

    const initial = read();
    toggle.checked = initial;
    apply(initial);

    toggle.addEventListener("change", () => {
      write(toggle.checked);
      apply(toggle.checked);
    });
  })();
</script>

<style>
  .compare {
    max-width: 1400px;
  }

  /* Confession pills and the punctuation setting share one row; the setting is
     pushed to the far end so the two kinds of control stay distinguishable.
     Both wrap onto their own lines when the row runs out of width. */
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin: 1rem 0;
  }

  .control {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-left: auto;
    font-size: 0.9rem;
    cursor: pointer;
  }

  /* The key sits above everything and stays put while the comparison scrolls
     under it — with 185 rows you are always a long way from where the colours
     were explained. Only this strip is sticky; the title and the pills scroll
     away normally.

     The offset is measured from the site header at runtime rather than
     hardcoded, because that header wraps to two lines on narrow screens. The
     negative inline margins let the strip span the card's padding, so nothing
     shows through at its edges as content passes beneath. */
  .jump-control {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
    font-size: 0.9rem;
  }

  .jump-control select {
    flex: 1 1 22rem;
    max-width: 40rem;
    padding: 0.35rem 0.5rem;
  }

  .legend {
    position: sticky;
    /* Fallback clears the header at its usual height (3.25rem logo plus
       0.9rem padding each side) in case the measuring script never runs. */
    top: var(--compare-header-offset, 5.25rem);
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    list-style: none;
    margin: -1rem -1rem 1rem;
    padding: 0.7rem 1rem;
    background: var(--card-bg);
    border-bottom: 1px solid var(--card-border);
    border-radius: 16px 16px 0 0;
    font-size: 0.8rem;
    opacity: 0.95;
  }

  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .swatch {
    display: inline-block;
    width: 1.1rem;
    height: 0.85rem;
    border-radius: 0.15rem;
  }

  .swatch-unique {
    background: var(--confession-accent-bg);
    box-shadow: inset 0 -2px 0 var(--confession-accent-border);
  }

  .swatch-shared {
    background: var(--diff-shared-bg);
    box-shadow: inset 0 -2px 0 var(--diff-shared-rule);
  }


  .lede {
    opacity: 0.8;
  }

  .combo-switch {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
  }

  .combo-switch a {
    border: 1px solid var(--border-subtle, #333);
    border-radius: 999px;
    padding: 0.3rem 0.85rem;
    font-size: 0.85rem;
    text-decoration: none;
  }

  .combo-switch a[aria-current="page"] {
    border-color: currentColor;
    font-weight: 600;
  }

  .compare-group {
    margin-top: 2.5rem;
  }

  .compare-group h2 {
    margin-bottom: 0.25rem;
  }

  .chapter-line {
    margin: 0;
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    opacity: 0.65;
  }

  .group-note {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    opacity: 0.8;
    border-left: 2px solid var(--border-subtle, #333);
    padding-left: 0.75rem;
  }
</style>
